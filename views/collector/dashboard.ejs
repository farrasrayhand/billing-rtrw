<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root{
      --bg:#f3f4f6;
      --panel:#ffffff;
      --panel2:#f8fafc;
      --muted:#4b5563;
      --text:#111827;
      --text-secondary:#374151;
      --border:#e5e7eb;
      --input-border:#cbd5e1;
      --primary:#2563eb;
    }
    body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}
    :focus-visible{outline:2px solid var(--primary);outline-offset:2px}
    .cardx{background:var(--panel);border:1px solid var(--border);border-radius:14px;box-shadow:0 1px 2px rgba(16,24,40,0.04);color:var(--text)}
    .form-control{background:var(--panel);border:1px solid var(--input-border);color:var(--text)}
    .form-control::placeholder{color:var(--muted)}
    .form-control:focus{background:var(--panel);color:var(--text);box-shadow:0 0 0 3px rgba(37,99,235,0.12);border-color:var(--primary)}
    .muted{color:var(--muted)!important}
    .btn-primary{background-color:var(--primary);border-color:var(--primary);color:#ffffff}
    .btn-primary:hover{background-color:#1d4ed8;border-color:#1d4ed8;color:#ffffff}
    .badgey{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:11px;font-weight:700;border:1px solid var(--border);background:var(--bg);color:var(--text-secondary)}
    .badgey.s{color:#166534;border-color:#bbf7d0;background:#dcfce7}
    .badgey.d{color:#991b1b;border-color:#fecaca;background:#fee2e2}
    .badgey.w{color:#92400e;border-color:#fde68a;background:#fef3c7}
    .tbl td{border-top:1px solid var(--border);padding:8px 0;font-size:12px;vertical-align:top;color:var(--text)}
    .tbl td:first-child{color:var(--muted);width:120px;padding-right:12px}
    .bn{position:fixed;left:0;right:0;bottom:0;z-index:2000;padding:10px 12px;background:var(--panel);border-top:1px solid var(--border);box-shadow:0 -1px 2px rgba(16,24,40,0.04)}
    .bnw{max-width:980px;margin:0 auto;display:flex;gap:8px;justify-content:space-between}
    .bni{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:8px 6px;border-radius:12px;text-decoration:none;color:var(--muted);border:1px solid var(--border);background:var(--panel2);min-height:44px}
    .bni i{font-size:18px;line-height:1}
    .bni span{font-size:10px;font-weight:700;letter-spacing:.02em}
    .bni.active{color:var(--primary);border-color:#bfdbfe;background:#eff6ff}
    .bni.active i{color:var(--primary)}
  </style>
</head>
<body>
  <div class="container" style="max-width:980px;padding-top:14px;padding-bottom:96px">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <div style="font-weight:800;letter-spacing:-.02em;color:var(--text)">Kolektor: <%= session.collectorName || 'Penagih' %></div>
        <div class="muted" style="font-size:12px">
          <%= company %>
          <% if (session.collectorArea) { %>
            <span class="badge ms-1" style="background:#eff6ff;color:#1e40af;border:1px solid #bfdbfe"><i class="bi bi-geo-alt"></i> Area: <%= session.collectorArea %></span>
          <% } else { %>
            <span class="badge ms-1" style="background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;font-weight:600"><i class="bi bi-globe"></i> Semua Area</span>
          <% } %>
        </div>
      </div>
      <div class="d-flex gap-2">
        <a class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" href="/collector/attendance">
          <i class="bi bi-calendar-check"></i> Absensi
        </a>
        <a class="btn btn-outline-secondary btn-sm" href="/collector/logout"><i class="bi bi-box-arrow-left"></i></a>
      </div>
    </div>

    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'danger':'success' %> d-flex align-items-center gap-2 flex-wrap">
        <span><%- msg.text %></span>
      </div>
    <% } %>

    <div class="row g-2 mb-3">
      <div class="col-6 col-md-3">
        <a class="cardx p-3 d-block text-decoration-none" href="/collector?<%= new URLSearchParams({ month: String(month), year: String(year), status: 'unpaid', scope: 'today', search: String(search||''), jump: 'data' }).toString() %>#data-tagihan">
          <div class="muted" style="font-size:12px">Tagihan Hari Ini (tgl <%= todayDay %>)</div>
          <div style="font-weight:800;font-size:20px;color:var(--text)"><%= Number(summary?.today_count || 0) %></div>
          <div class="muted" style="font-size:12px">Rp <%= Number(summary?.today_total || 0).toLocaleString('id-ID') %></div>
        </a>
      </div>
      <div class="col-6 col-md-3">
        <a class="cardx p-3 d-block text-decoration-none" href="/collector?<%= new URLSearchParams({ month: String(month), year: String(year), status: 'unpaid', scope: 'unpaid', search: String(search||''), jump: 'data' }).toString() %>#data-tagihan">
          <div class="muted" style="font-size:12px">Tagihan Belum Bayar</div>
          <div style="font-weight:800;font-size:20px;color:var(--text)"><%= Number(summary?.unpaid_count || 0) %></div>
          <div class="muted" style="font-size:12px">Rp <%= Number(summary?.unpaid_total || 0).toLocaleString('id-ID') %></div>
        </a>
      </div>
      <div class="col-6 col-md-3">
        <a class="cardx p-3 d-block text-decoration-none" href="/collector?<%= new URLSearchParams({ month: String(month), year: String(year), status: 'unpaid', scope: 'isolir', search: String(search||''), jump: 'data' }).toString() %>#data-tagihan">
          <div class="muted" style="font-size:12px">Tagihan Isolir</div>
          <div style="font-weight:800;font-size:20px;color:var(--text)"><%= Number(summary?.isolir_count || 0) %></div>
          <div class="muted" style="font-size:12px">Rp <%= Number(summary?.isolir_total || 0).toLocaleString('id-ID') %></div>
        </a>
      </div>
      <div class="col-6 col-md-3">
        <a class="cardx p-3 d-block text-decoration-none" href="/collector?<%= new URLSearchParams({ month: String(month), year: String(year), status: 'unpaid', scope: 'multi', search: String(search||''), jump: 'data' }).toString() %>#data-tagihan">
          <div class="muted" style="font-size:12px">Menunggak &gt; 1 Bulan</div>
          <div style="font-weight:800;font-size:20px;color:var(--text)"><%= Number(summary?.multi_customer_count || 0) %></div>
          <div class="muted" style="font-size:12px">Rp <%= Number(summary?.multi_total || 0).toLocaleString('id-ID') %></div>
        </a>
      </div>
    </div>

    <div class="cardx p-3 mb-3">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <div style="font-weight:800"><i class="bi bi-receipt text-primary me-1"></i> Daftar Tagihan</div>
        <span class="badgey"><i class="bi bi-shield-check"></i>Read Only</span>
      </div>
      <form method="GET" action="/collector" class="d-flex gap-2 flex-wrap">
        <select class="form-control" name="month" style="max-width:110px">
          <% for (let m=1; m<=12; m++) { %>
            <option value="<%= m %>" <%= Number(month)===m ? 'selected' : '' %>><%= String(m).padStart(2,'0') %></option>
          <% } %>
        </select>
        <select class="form-control" name="year" style="max-width:120px">
          <% const baseY = Number(year) || new Date().getFullYear(); %>
          <% for (let y=baseY-2; y<=baseY+1; y++) { %>
            <option value="<%= y %>" <%= Number(year)===y ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>
        <select class="form-control" name="status" style="max-width:170px">
          <option value="unpaid" <%= String(status)==='unpaid' ? 'selected' : '' %>>Belum Bayar</option>
          <option value="paid" <%= String(status)==='paid' ? 'selected' : '' %>>Lunas</option>
          <option value="all" <%= String(status)==='all' ? 'selected' : '' %>>Semua</option>
        </select>
        <select class="form-control" name="scope" style="max-width:200px">
          <option value="" <%= !scope ? 'selected' : '' %>>Semua Pelanggan</option>
          <option value="today" <%= String(scope)==='today' ? 'selected' : '' %>>Tagihan Hari Ini</option>
          <option value="unpaid" <%= String(scope)==='unpaid' ? 'selected' : '' %>>Belum Bayar (Filter)</option>
          <option value="isolir" <%= String(scope)==='isolir' ? 'selected' : '' %>>Isolir</option>
          <option value="multi" <%= String(scope)==='multi' ? 'selected' : '' %>>Menunggak &gt; 1 Bulan</option>
        </select>
        <input class="form-control" name="search" value="<%= search || '' %>" placeholder="Cari (opsional): nama / HP / PPPoE / TAG">
        <button class="btn btn-primary" type="submit" style="min-width:90px"><i class="bi bi-funnel"></i></button>
      </form>
      <div class="muted mt-2" style="font-size:12px">
        Menampilkan maks 500 tagihan periode <span style="font-weight:800;color:var(--text)"><%= String(month).padStart(2,'0') %>/<%= year %></span>.
      </div>
    </div>

    <div class="cardx p-3 mb-3" id="data-tagihan">
      <div style="font-weight:800" class="mb-2"><i class="bi bi-list-ul text-primary me-1"></i> Data Pelanggan & Tagihan Area (<%= (invoices || []).length %>)</div>
      <% if (!invoices || invoices.length === 0) { %>
        <div class="muted" style="font-size:12px">Tidak ada data pelanggan untuk filter ini.</div>
      <% } else { %>
        <div class="d-flex flex-column gap-2">
          <% invoices.forEach(inv => { 
               const invId = inv.invoice_id;
               const isPaid = String(inv.invoice_status||'').toLowerCase()==='paid';
               const reqRow = pendingMap && pendingMap.get ? (pendingMap.get('inv_' + invId) || pendingMap.get('cust_' + inv.customer_id)) : null;
               const reqStatus = reqRow ? String(reqRow.status||'') : '';
               const isPending = reqStatus === 'pending';
               const noInvoice = !invId;
               const amount = Number(inv.invoice_amount || inv.package_price || 0);
          %>
            <div style="background:var(--panel2);border:1px solid var(--border);border-radius:12px;padding:12px">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div style="min-width:0">
                  <div style="font-weight:800;color:var(--text)">
                    <%= inv.customer_name || '-' %>
                    <span class="muted" style="font-size:12px"><%= inv.customer_phone ? '('+inv.customer_phone+')' : '' %></span>
                    <% if (inv.customer_status === 'suspended') { %>
                      <span class="badgey d ms-1" style="font-size:10px;padding:2px 8px"><i class="bi bi-pause-circle"></i> ISOLIR</span>
                    <% } else if (inv.customer_status === 'active') { %>
                      <span class="badgey s ms-1" style="font-size:10px;padding:2px 8px"><i class="bi bi-check-circle"></i> Aktif</span>
                    <% } else { %>
                      <span class="badgey ms-1" style="font-size:10px;padding:2px 8px"><%= inv.customer_status %></span>
                    <% } %>
                  </div>
                  <div class="muted" style="font-size:12px"><%= inv.package_name || 'Internet' %> <%= invId ? ('• Invoice #' + invId) : '• Belum Ada Invoice' %></div>
                </div>
                <div class="text-end">
                  <div style="font-weight:800;color:var(--text)">Rp <%= amount.toLocaleString('id-ID') %></div>
                  <% if (isPaid) { %>
                    <span class="badgey s"><i class="bi bi-check-circle"></i> LUNAS</span>
                  <% } else if (isPending) { %>
                    <span class="badgey w"><i class="bi bi-hourglass"></i> MENUNGGU APPROVAL</span>
                  <% } else if (noInvoice) { %>
                    <span class="badgey" style="background:#eff6ff;color:#1e40af;border-color:#bfdbfe"><i class="bi bi-file-earmark-plus"></i> BELUM TAGIHAN</span>
                  <% } else { %>
                    <span class="badgey d"><i class="bi bi-exclamation-circle"></i> BELUM BAYAR</span>
                  <% } %>
                </div>
              </div>

              <table class="tbl mt-2" style="width:100%;border-collapse:collapse">
                <tr><td>Periode</td><td><%= month %>/<%= year %></td></tr>
                <tr><td>Area / Wilayah</td><td><strong style="color:#1e40af"><%= inv.customer_area || '-' %></strong></td></tr>
                <tr><td>Jatuh Tempo</td><td><%= inv.isolate_day ? ('Tgl ' + inv.isolate_day) : '-' %></td></tr>
                <tr><td>ID Pelanggan</td><td>#<%= inv.customer_id %></td></tr>
                <tr><td>PPPoE</td><td><%= inv.pppoe_username ? inv.pppoe_username : '-' %></td></tr>
                <tr><td>Tag ONU</td><td><%= inv.genieacs_tag ? inv.genieacs_tag : '-' %></td></tr>
                <tr><td>Alamat</td><td><%= inv.customer_address ? inv.customer_address : '-' %></td></tr>
              </table>

              <div class="d-flex flex-wrap gap-2 mt-2">
                <% if (inv.lat && inv.lng) { %>
                  <a class="btn btn-outline-secondary btn-sm" target="_blank" href="https://www.google.com/maps?q=<%= encodeURIComponent(inv.lat + ',' + inv.lng) %>"><i class="bi bi-geo-alt"></i> Map</a>
                <% } %>
                <% if (isPaid && inv.invoice_id) { %>
                  <a class="btn btn-primary btn-sm fw-bold shadow-sm" target="_blank" href="/collector/invoice/<%= inv.invoice_id %>/print-thermal">
                    <i class="bi bi-printer"></i> Cetak Struk (Thermal)
                  </a>
                  <a class="btn btn-outline-primary btn-sm fw-bold" target="_blank" href="/customer/invoice/<%= inv.invoice_id %>/pdf">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                  </a>
                  <button type="button" class="btn btn-outline-success btn-sm fw-bold" onclick="sendWaPdf('<%= inv.invoice_id %>')">
                    <i class="bi bi-whatsapp"></i> Kirim WA PDF
                  </button>
                <% } else if (!isPaid && !isPending) { %>
                  <form method="POST" action="/collector/payment-request" class="d-flex gap-2" style="flex:1;min-width:260px">
                    <input type="hidden" name="customer_id" value="<%= inv.customer_id %>">
                    <input type="hidden" name="invoice_id" value="<%= inv.invoice_id || '' %>">
                    <input type="hidden" name="month" value="<%= month %>">
                    <input type="hidden" name="year" value="<%= year %>">
                    <input type="hidden" name="status" value="<%= status %>">
                    <input type="hidden" name="search" value="<%= search || '' %>">
                    <input class="form-control form-control-sm" name="note" placeholder="Catatan (opsional)">
                    <button class="btn btn-primary btn-sm fw-bold" type="submit">
                      <i class="bi bi-cash-stack"></i> <%= noInvoice ? 'Buat & Bayar Tagihan' : 'Ajukan Pembayaran' %>
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="cardx p-3">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <div style="font-weight:800"><i class="bi bi-list-ul text-primary me-1"></i> Riwayat Pengajuan Saya</div>
        <span class="badgey"><%= (myReqs || []).length %></span>
      </div>
      <% if (!myReqs || myReqs.length === 0) { %>
        <div class="muted" style="font-size:12px">Belum ada pengajuan.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm align-middle" style="margin:0;color:var(--text)">
            <thead>
              <tr style="border-bottom:1px solid var(--border);color:var(--muted);font-size:12px">
                <th>Waktu</th>
                <th>Pelanggan</th>
                <th>Periode</th>
                <th class="text-end">Nominal</th>
                <th>Status / Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% myReqs.forEach(r => { %>
                <% const st = String(r.status||''); %>
                <tr style="border-bottom:1px solid var(--border)">
                  <td style="font-size:12px"><%= r.created_at ? new Date(r.created_at).toLocaleString('id-ID') : '-' %></td>
                  <td style="font-size:12px"><%= r.customer_name || '-' %> <span class="muted"><%= r.customer_phone ? '('+r.customer_phone+')' : '' %></span></td>
                  <td style="font-size:12px"><%= r.period_month %>/<%= r.period_year %></td>
                  <td class="text-end" style="font-size:12px;font-weight:600">Rp <%= Number(r.amount||0).toLocaleString('id-ID') %></td>
                  <td style="font-size:12px">
                    <% if (st === 'approved') { %>
                      <span class="badgey s">APPROVED</span>
                      <a href="/collector/invoice/<%= r.invoice_id %>/print-thermal" target="_blank" class="btn btn-sm btn-outline-secondary ms-1" style="font-size:11px;padding:2px 6px;" title="Cetak Struk Thermal"><i class="bi bi-printer"></i> Struk</a>
                    <% } else if (st === 'rejected') { %>
                      <span class="badgey d">REJECTED</span>
                    <% } else { %>
                      <span class="badgey w">PENDING</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3" class="muted" style="font-size:12px">Total pengajuan (halaman ini)</td>
                <td class="text-end" style="font-size:12px;font-weight:800;color:var(--text)">Rp <%= (myReqs || []).reduce((s, r) => s + (Number(r.amount||0) || 0), 0).toLocaleString('id-ID') %></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <%
    const qsBase = { month: String(month), year: String(year), search: String(search || '') };
    const qsAll = new URLSearchParams({ ...qsBase, status: String(status || 'all'), scope: '' }).toString();
    const qsToday = new URLSearchParams({ ...qsBase, status: 'unpaid', scope: 'today' }).toString();
    const qsUnpaid = new URLSearchParams({ ...qsBase, status: 'unpaid', scope: 'unpaid' }).toString();
    const qsIsolir = new URLSearchParams({ ...qsBase, status: 'unpaid', scope: 'isolir' }).toString();
    const qsMulti = new URLSearchParams({ ...qsBase, status: 'unpaid', scope: 'multi' }).toString();
    const activeScope = String(scope || '');
    const activeStatus = String(status || '');
  %>
  <div class="bn">
    <div class="bnw">
      <a class="bni <%= (!activeScope && (activeStatus === 'all' || activeStatus === 'paid' || activeStatus === 'unpaid')) ? 'active' : '' %>" href="/collector?<%= qsAll %>#data-tagihan">
        <i class="bi bi-grid-3x3-gap"></i><span>Semua</span>
      </a>
      <a class="bni <%= activeScope === 'today' ? 'active' : '' %>" href="/collector?<%= qsToday %>#data-tagihan">
        <i class="bi bi-calendar-check"></i><span>Hari Ini</span>
      </a>
      <a class="bni <%= activeScope === 'unpaid' ? 'active' : '' %>" href="/collector?<%= qsUnpaid %>#data-tagihan">
        <i class="bi bi-exclamation-circle"></i><span>Belum</span>
      </a>
      <a class="bni <%= activeScope === 'isolir' ? 'active' : '' %>" href="/collector?<%= qsIsolir %>#data-tagihan">
        <i class="bi bi-shield-exclamation"></i><span>Isolir</span>
      </a>
      <a class="bni <%= activeScope === 'multi' ? 'active' : '' %>" href="/collector?<%= qsMulti %>#data-tagihan">
        <i class="bi bi-layers"></i><span>&gt;1 Bln</span>
      </a>
      <a class="bni" href="/collector/attendance">
        <i class="bi bi-calendar-check-fill"></i><span>Absensi</span>
      </a>
    </div>
  </div>

  <script>
    (function () {
      try {
        const u = new URL(window.location.href);
        if (u.hash === '#data-tagihan') {
          const el = document.getElementById('data-tagihan');
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch (e) {}
    })();

    async function sendWaPdf(invId) {
      if (!confirm('Kirimkan dokumen Invoice PDF ke WhatsApp pelanggan sekarang?')) return;
      try {
        const res = await fetch('/collector/invoice/' + invId + '/send-pdf-wa', { method: 'POST' });
        const data = await res.json();
        alert(data.message || (data.success ? 'Berhasil dikirim!' : 'Gagal mengirim'));
      } catch (e) {
        alert('Error: ' + e.message);
      }
    }
  </script>
</body>
</html>
