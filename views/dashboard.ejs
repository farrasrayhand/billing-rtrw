    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background:#ffffff; border:1px solid #e5e7eb; border-radius:16px; color:#111827;">
        <div class="modal-header border-0 pb-0" style="padding:24px 24px 10px;">
          <h5 class="modal-title fw-bold fs-5" style="color:#111827"><i class="bi bi-wifi me-2 fs-4" style="color:#0369a1"></i>Ubah Nama WiFi (SSID)</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/customer/change-ssid" method="POST">
          <div class="modal-body p-4">
            <div class="mb-3">
