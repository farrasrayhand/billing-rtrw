              <input type="text" name="ssid" id="modalSsidInput" class="form-control p-3" style="border-radius:10px; font-weight:600;" placeholder="Contoh: WiFi_Rumah_Keluarga" required>
              <div class="form-text small">Format nama WiFi bebas. Perangkat akan terputus sesaat setelah nama WiFi diubah.</div>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal" style="border-radius:10px;">Batal</button>
            <button type="submit" class="btn btn-primary fw-bold px-4 flex-grow-1" style="border-radius:10px;">Simpan Nama WiFi</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL EDIT PASSWORD -->
  <div class="modal fade" id="editPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background:#ffffff; border:1px solid #e5e7eb; border-radius:16px; color:#111827;">
        <div class="modal-header border-0 pb-0" style="padding:24px 24px 10px;">
          <h5 class="modal-title fw-bold fs-5" style="color:#111827"><i class="bi bi-shield-lock me-2 fs-4" style="color:#15803d"></i>Ubah Password WiFi</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/customer/change-password" method="POST">
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:13px;">Password WiFi Baru (Minimal 8 Karakter)</label>
              <input type="password" name="password" id="modalPassInput" class="form-control p-3" minlength="8" style="border-radius:10px; font-weight:600;" placeholder="Contoh: Rahasia12345" required>
              <div class="form-text small">Gunakan minimal 8 kombinasi huruf dan angka. Simpan password baru ini baik-baik.</div>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal" style="border-radius:10px;">Batal</button>
            <button type="submit" class="btn text-white fw-bold px-4 flex-grow-1" style="background:#15803d; border-radius:10px;">Simpan Password</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL REBOOT DEVICE -->
  <div class="modal fade" id="rebootModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background:#ffffff; border:1px solid #e5e7eb; border-radius:16px; color:#111827;">
        <div class="modal-header border-0 pb-0" style="padding:24px 24px 10px;">
          <h5 class="modal-title fw-bold fs-5" style="color:#111827"><i class="bi bi-arrow-clockwise me-2 fs-4" style="color:#b45309"></i>Reboot Router / Modem</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/customer/reboot" method="POST">
          <div class="modal-body p-4 text-center">
            <div class="p-3 mb-3 rounded-circle d-inline-flex" style="background:#fef3c7; color:#b45309;">
              <i class="bi bi-exclamation-triangle-fill fs-1"></i>
            </div>
            <h6 class="fw-bold mb-2" style="color:#111827">Apakah Anda yakin ingin menyalakan ulang modem?</h6>
            <p class="small mb-0" style="color:#374151; font-weight:500;">Proses reboot membutuhkan waktu sekitar 1-2 menit. Selama booting berlangsung, koneksi internet WiFi Anda akan terputus sementara.</p>
          </div>
          <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal" style="border-radius:10px;">Batal</button>
            <button type="submit" class="btn text-white fw-bold px-4 flex-grow-1" style="background:#b45309; border-radius:10px;">Ya, Reboot Sekarang</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL TIKET KELUHAN -->
  <div class="modal fade" id="ticketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background:#ffffff; border:1px solid #e5e7eb; border-radius:16px; color:#111827;">
        <div class="modal-header border-0 pb-0" style="padding:24px 24px 10px;">
          <h5 class="modal-title fw-bold fs-5" style="color:#111827"><i class="bi bi-headset me-2 fs-4" style="color:#7c3aed;"></i>Buat Tiket Keluhan Baru</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/customer/tickets/create" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="customerId" value="<%= profile ? profile.id : '' %>">
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:13px;">Jenis Kendala / Subjek</label>
              <select name="subject" class="form-select p-3" style="border-radius:10px; font-weight:600;" required>
                <option value="" disabled selected>-- Pilih Jenis Kendala --</option>
                <option value="Koneksi Terputus / Tidak Bisa Konek">Koneksi Terputus / Tidak Bisa Konek</option>
                <option value="Koneksi Lambat / Lemot">Koneksi Lambat / Lemot</option>
                <option value="Lampu PON Merah / Los Sinyal">Lampu PON Merah / Los Sinyal</option>
                <option value="Kendala Lupa Password WiFi">Kendala Lupa Password WiFi</option>
                <option value="Pertanyaan Tagihan & Pembayaran">Pertanyaan Tagihan & Pembayaran</option>
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:13px;">Detail Pesan / Penjelasan Kendala</label>
              <textarea name="message" class="form-control p-3" rows="3" style="border-radius:10px; font-weight:600;" placeholder="Contoh: Lampu indikator PON kedap-kedip merah sejak tadi pagi di Dusun Janggar..." required></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:13px;">Foto Lampiran (Opsional)</label>
              <input type="file" name="photos" class="form-control" accept="image/*" multiple style="border-radius:10px;">
            </div>
          </div>
          <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal" style="border-radius:10px;">Batal</button>
            <button type="submit" class="btn btn-primary text-white fw-bold px-4 flex-grow-1" style="border-radius:10px;">Kirim Tiket Keluhan</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('partials/customer_bottom_nav', { activeNav: 'home' }) %>

  <!-- JAVASCRIPT HANDLERS -->
  <script>
    let currentInvId = null;
    let pModal = null;

    function openPaymentModal(invId, amount) {
      currentInvId = invId;
      let num = 0;
      if (typeof amount === 'number') {
        num = isNaN(amount) ? 0 : amount;
      } else if (amount) {
        const clean = String(amount).replace(/[^0-9.]/g, '');
        num = parseFloat(clean) || 0;
      }
      document.getElementById('pay_amount_text').innerText = 'Rp ' + Math.round(num).toLocaleString('id-ID');
      if (!pModal) pModal = new bootstrap.Modal(document.getElementById('paymentModal'));
      pModal.show();
    }

    function submitPayment(method) {
      if (!currentInvId) return;
      window.location.href = `/customer/payment/create/${currentInvId}?method=${method}`;
    }

    function togglePassVisibility() {
      const input = document.getElementById('wifiPassInput');
      const icon = document.getElementById('eyeIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
      } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
      }
    }

    function openNotifDrawer() {
      const modal = new bootstrap.Modal(document.getElementById('notifDrawerModal'));
      modal.show();
    }

    function editSsid(deviceId, currentSsid) {
      document.getElementById('modalSsidInput').value = currentSsid || '';
      const m = new bootstrap.Modal(document.getElementById('editSsidModal'));
      m.show();
    }

    function editPassword(deviceId) {
      document.getElementById('modalPassInput').value = '';
      const m = new bootstrap.Modal(document.getElementById('editPasswordModal'));
      m.show();
    }

    function rebootDevice(deviceId) {
      const m = new bootstrap.Modal(document.getElementById('rebootModal'));
      m.show();
    }

    // LIVE TRAFFIC GAUGES CANVAS
    function drawGauge(canvasId, valueMbps, maxMbps, strokeColor) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h - 20;
      const radius = 75;

      ctx.clearRect(0, 0, w, h);

      // Track Arc (180 deg)
      ctx.beginPath();
      ctx.arc(cx, cy, radius, Math.PI, 2 * Math.PI, false);
      ctx.lineWidth = 14;
      ctx.strokeStyle = '#e5e7eb';
      ctx.lineCap = 'round';
      ctx.stroke();

      // Progress Arc
      const val = Math.min(Math.max(0, valueMbps), maxMbps);
      const ratio = maxMbps > 0 ? val / maxMbps : 0;
      const endAngle = Math.PI + ratio * Math.PI;

      if (ratio > 0) {
        ctx.beginPath();
        ctx.arc(cx, cy, radius, Math.PI, endAngle, false);
        ctx.lineWidth = 14;
        ctx.strokeStyle = strokeColor;
        ctx.lineCap = 'round';
        ctx.stroke();
      }
    }

    async function fetchTrafficData() {
      try {
        const res = await fetch('/customer/api/pppoe-traffic', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();

        const rxGauge = document.getElementById('pppoe_rx_gauge');
        const txGauge = document.getElementById('pppoe_tx_gauge');

        const maxDown = parseFloat(rxGauge?.dataset?.max) || 10;
        const maxUp = parseFloat(txGauge?.dataset?.max) || 10;

        const rx = parseFloat(data.rxMbps || data.rx_rate || 0) || 0;
        const tx = parseFloat(data.txMbps || data.tx_rate || 0) || 0;

        const rxValEl = document.getElementById('pppoe_rx_value');
        const rxUnitEl = document.getElementById('pppoe_rx_unit');
        if (rxValEl) rxValEl.innerText = rx < 0.1 ? (rx * 1000).toFixed(0) : rx.toFixed(2);
        if (rxUnitEl) rxUnitEl.innerText = rx < 0.1 ? 'Kbps' : 'Mbps';

        const txValEl = document.getElementById('pppoe_tx_value');
        const txUnitEl = document.getElementById('pppoe_tx_unit');
        if (txValEl) txValEl.innerText = tx < 0.1 ? (tx * 1000).toFixed(0) : tx.toFixed(2);
        if (txUnitEl) txUnitEl.innerText = tx < 0.1 ? 'Kbps' : 'Mbps';

        drawGauge('pppoe_rx_gauge', rx, maxDown, '#2563eb');
        drawGauge('pppoe_tx_gauge', tx, maxUp, '#15803d');
      } catch (e) {
        console.error('[Traffic] Fetch error:', e);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadCustomerWebNotifs();
      fetchTrafficData();
      setInterval(fetchTrafficData, 3000);

      const btnRefresh = document.getElementById('btnDeviceRefresh');
      if (btnRefresh) {
        btnRefresh.addEventListener('click', async () => {
          btnRefresh.disabled = true;
          btnRefresh.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Memeriksa ONU...';
          try {
            await fetch('/customer/poll-onu', { method: 'POST' });
            location.reload();
          } catch (e) {
            location.reload();
          }
        });
      }
    });

    function loadCustomerWebNotifs() {
      const container = document.getElementById('notifListContainer');
      if (!container) return;

      const notifs = [];
      <% if (paidInvoices && paidInvoices.length > 0) { %>
        <% paidInvoices.slice(0, 3).forEach(inv => { %>
          <% const pAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
          notifs.push({
            id: 'paid-<%= inv.id %>',
            type: 'payment',
            title: 'Pelunasan Tagihan Berhasil',
            message: 'Tagihan bulan <%= inv.period_month %>/<%= inv.period_year %> sebesar Rp <%= parseInt(pAmt || 0).toLocaleString("id-ID") %> telah LUNAS.',
            time: 'Terkonfirmasi Sistem'
          });
        <% }) %>
      <% } %>

      <% if (hasUnpaid) { %>
        <% const uAmt = latestUnpaid.amount != null ? latestUnpaid.amount : (latestUnpaid.package_price != null ? latestUnpaid.package_price : 0); %>
        notifs.push({
          id: 'unpaid-latest',
          type: 'warning',
          title: 'Pengingat Tagihan Bulanan',
          message: 'Tagihan bulan <%= latestUnpaid.period_month %>/<%= latestUnpaid.period_year %> sebesar Rp <%= parseInt(uAmt || 0).toLocaleString("id-ID") %> menunggu pembayaran.',
          time: 'Jatuh Tempo Tgl 20'
        });
      <% } %>

      const badge = document.getElementById('notifCountBadge');
      if (badge && notifs.length > 0) {
        badge.innerText = notifs.length;
        badge.style.display = 'flex';
      }

      if (notifs.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-bell-slash fs-1 d-block mb-2"></i>Belum ada notifikasi baru</div>';
      } else {
        container.innerHTML = notifs.map(n => `
          <div class="notif-item ${n.type === 'payment' ? 'unread' : ''}">
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="bi bi-${n.type === 'payment' ? 'check-circle-fill text-success' : 'exclamation-circle-fill text-warning'}"></i>
              <span class="fw-bold small" style="color:#111827">${n.title}</span>
            </div>
            <div class="small mb-1" style="font-size:12px; color:#374151;">${n.message}</div>
            <div class="text-muted" style="font-size:10px;">${n.time}</div>
          </div>
        `).join('');
      }
    }
  </script>
</body>

</html>
