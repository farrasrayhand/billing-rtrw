<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('agent.login_title', 'Login Agent') %> - <%= company %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --bg: #f3f4f6;
      --card: #ffffff;
      --border: #e5e7eb;
      --input-border: #cbd5e1;
      --text: #111827;
      --muted: #4b5563;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      padding: 16px;
    }

    :focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .text-secondary {
      color: var(--muted) !important;
    }

    .login-card {
      background: var(--card);
      border-radius: 16px;
      padding: 32px 28px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
      border: 1px solid var(--border);
    }

    .form-control {
      background: var(--card);
      border: 1px solid var(--input-border);
      color: var(--text);
      padding: 12px;
      border-radius: 10px;
    }

    .form-control::placeholder {
      color: var(--muted);
    }

    .form-control:focus {
      background: var(--card);
      color: var(--text);
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .btn-login {
      background: var(--primary);
      color: #ffffff;
      border: none;
      padding: 12px;
      border-radius: 10px;
      width: 100%;
      font-weight: 600;
      margin-top: 10px;
      min-height: 44px;
    }

    .btn-login:hover {
      background: var(--primary-hover);
      color: #ffffff;
    }

    .brand-icon {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      background: #eff6ff;
      color: var(--primary);
      font-size: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }
  </style>
</head>
<body>
  <div class="login-card text-center">
    <div class="brand-icon"><i class="bi bi-person-badge"></i></div>
    <h3 class="mb-1 fw-bold" style="color: var(--text);"><%= t('agent.portal_title', 'Portal Agent') %></h3>
    <p class="text-secondary mb-4 small"><%= company %></p>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small rounded-3">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/agent/login">
      <div class="mb-3 text-start">
        <label class="form-label text-secondary small mb-1 fw-semibold"><%= t('agent.username', 'Username') %></label>
        <input type="text" name="username" class="form-control" required placeholder="<%= t('agent.username_placeholder', 'Masukkan username') %>">
      </div>
      <div class="mb-4 text-start">
        <label class="form-label text-secondary small mb-1 fw-semibold"><%= t('agent.password', 'Password') %></label>
        <input type="password" name="password" class="form-control" required placeholder="<%= t('agent.password_placeholder', 'Masukkan password') %>">
      </div>
      <button type="submit" class="btn btn-login"><i class="bi bi-box-arrow-in-right me-2"></i> <%= t('agent.sign_in', 'Masuk') %></button>
    </form>
  </div>
</body>
</html>
