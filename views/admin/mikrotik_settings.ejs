<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Pengaturan MikroTik | <%= company %></title>
  <meta name="theme-color" content="#f7f8fa">
  <link rel="manifest" href="/admin/manifest.webmanifest">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'mikrotik', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-gear"></i> Pengaturan MikroTik</div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">
    <%- include('partials/tabs_mikrotik', { mTab: 'settings' }) %>

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <span><%= msg.text %></span>
    </div>
    <% } %>

    <form method="POST" action="/admin/mikrotik/settings">
      <div class="card mb16">
        <div class="card-hd"><h6 style="margin:0"><i class="bi bi-shuffle"></i> Mode Operasional Router</h6></div>
        <div class="card-bd">
          <div class="form-row">
            <div class="fg" style="flex:1">
              <label class="fl">Mode Multi-Router</label>
              <select class="fs" name="multi_router_mode" id="multi_router_mode_select" onchange="toggleMultiRouterUI()">
                <option value="active" <%= (settings.multi_router_mode === 'active' || !settings.multi_router_mode) ? 'selected' : '' %>>Aktif (Multiple Router)</option>
                <option value="disabled" <%= settings.multi_router_mode === 'disabled' ? 'selected' : '' %>>Nonaktif (Single Router Mode)</option>
              </select>
              <div class="hint">Aktif = kelola banyak router (lihat tab Router). Nonaktif = single router dengan fallback otomatis.</div>
            </div>
            <div class="fg" id="default_router_div" style="flex:1; <%= (settings.multi_router_mode === 'disabled') ? '' : 'display:none' %>">
              <label class="fl">Default Router ID <span style="color:var(--muted); font-weight:normal;">(Opsional)</span></label>
              <input class="fc" type="number" name="default_router_id" value="<%= settings.default_router_id || '' %>" placeholder="Kosongkan untuk auto-detect" min="1">
              <div class="hint">Jika kosong, sistem auto-detect router aktif pertama (ID terkecil).</div>
            </div>
          </div>
        </div>
      </div>

      <div id="mikrotik_router_hint" class="hint" style="margin-bottom:16px; <%= (settings.multi_router_mode === 'disabled') ? 'display:none' : '' %>">
        Mode multi-router aktif — kredensial &amp; daftar router diatur di tab <strong>Router</strong>. Isian di bawah hanya dipakai sebagai fallback (single router).
      </div>

      <div id="mikrotik_settings_group" style="<%= (settings.multi_router_mode === 'active' || !settings.multi_router_mode) ? 'display:none;' : '' %>">
        <div class="card mb16">
          <div class="card-hd"><h6 style="margin:0"><i class="bi bi-router"></i> Kredensial Router (Fallback Single Router)</h6></div>
          <div class="card-bd">
            <div class="form-row">
              <div class="fg">
                <label class="fl">MikroTik IP / Host</label>
                <input class="fc" name="mikrotik_host" value="<%= settings.mikrotik_host || '' %>" placeholder="192.168.1.1">
              </div>
              <div class="fg">
                <label class="fl">MikroTik API Port</label>
                <input class="fc" type="number" name="mikrotik_port" value="<%= settings.mikrotik_port || 8728 %>" placeholder="8728">
              </div>
            </div>
            <div class="form-row">
              <div class="fg">
                <label class="fl">MikroTik API User</label>
                <input class="fc" name="mikrotik_user" value="<%= settings.mikrotik_user || '' %>">
              </div>
              <div class="fg">
                <label class="fl">MikroTik API Password</label>
                <input class="fc" type="password" name="mikrotik_password" value="<%= settings.mikrotik_password || '' %>">
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="mikrotik_test_result" class="hint" style="display:none;margin-bottom:12px"></div>
      <div style="display:flex;justify-content:flex-end;gap:10px">
        <button type="button" class="btn btn-g" id="mikrotik_test_btn" onclick="testMikrotikConnection()"><i class="bi bi-plug"></i> Tes Koneksi</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan Pengaturan MikroTik</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleMultiRouterUI() {
    const mode = document.getElementById('multi_router_mode_select')?.value || 'active';
    const div = document.getElementById('default_router_div');
    if (div) div.style.display = (mode === 'disabled') ? 'block' : 'none';
    const grp = document.getElementById('mikrotik_settings_group');
    if (grp) grp.style.display = (mode === 'disabled') ? 'block' : 'none';
    const hint = document.getElementById('mikrotik_router_hint');
    if (hint) hint.style.display = (mode === 'disabled') ? 'none' : 'block';
  }

  async function testMikrotikConnection() {
    const f = document.querySelector('form[action="/admin/mikrotik/settings"]');
    const box = document.getElementById('mikrotik_test_result');
    const btn = document.getElementById('mikrotik_test_btn');
    const show = function (ok, text) {
      box.style.display = 'block';
      box.style.color = ok ? '#166534' : '#991b1b';
      box.style.background = ok ? '#dcfce7' : '#fee2e2';
      box.style.border = '1px solid ' + (ok ? '#bbf7d0' : '#fecaca');
      box.style.borderRadius = '10px';
      box.style.padding = '10px 14px';
      box.textContent = (ok ? '✔ ' : '✖ ') + text;
    };
    btn.disabled = true;
    box.style.display = 'block';
    box.removeAttribute('style');
    box.style.display = 'block';
    box.textContent = 'Menguji koneksi...';
    try {
      const res = await fetch('/admin/mikrotik/settings/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          host: f.mikrotik_host.value,
          port: f.mikrotik_port.value,
          user: f.mikrotik_user.value,
          password: f.mikrotik_password.value
        })
      });
      const data = await res.json();
      show(Boolean(data.ok), (data.message || 'Selesai.') + (data.ok && data.ms ? ' (' + data.ms + ' ms)' : ''));
    } catch (e) {
      show(false, 'Gagal menjalankan tes: ' + e.message);
    } finally {
      btn.disabled = false;
    }
  }
</script>
</body>
</html>
