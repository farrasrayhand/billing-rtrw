<!-- views/admin/partials/tabs_mikrotik.ejs — tab bersama area MikroTik (butuh variabel mTab) -->
<div class="hub-tabs">
  <a href="/admin/mikrotik" class="hub-tab <%= mTab === 'monitoring' ? 'active' : '' %>"><i class="bi bi-router"></i> Monitoring</a>
  <% if (typeof hotspotEnabled === 'undefined' || hotspotEnabled) { %>
  <a href="/admin/vouchers" class="hub-tab <%= mTab === 'vouchers' ? 'active' : '' %>"><i class="bi bi-ticket-perforated"></i> Voucher Hotspot</a>
  <a href="/admin/vouchers/packages" class="hub-tab <%= mTab === 'packages' ? 'active' : '' %>"><i class="bi bi-ticket-detailed"></i> Paket Voucher</a>
  <% } %>
  <% if (typeof multiRouterMode !== 'undefined' && multiRouterMode && typeof session !== 'undefined' && session && session.isAdmin) { %>
  <a href="/admin/routers" class="hub-tab <%= mTab === 'routers' ? 'active' : '' %>"><i class="bi bi-hdd-network"></i> Router</a>
  <% } %>
  <% if (typeof session !== 'undefined' && session && session.isAdmin) { %>
  <a href="/admin/mikrotik/settings" class="hub-tab <%= mTab === 'settings' ? 'active' : '' %>"><i class="bi bi-gear"></i> Pengaturan</a>
  <% } %>
</div>
