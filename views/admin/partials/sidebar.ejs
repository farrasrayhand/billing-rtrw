<!-- views/admin/partials/sidebar.ejs -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
<aside class="sidebar" id="sidebar">
  <div class="sb-brand">
    <div class="sb-brand-left">
      <div class="sb-icon"><i class="bi bi-box-seam"></i></div>
      <div class="sb-name" title="<%= company %>"><%= company %></div>
    </div>
    <div class="sb-lang" role="group" aria-label="Pilih Bahasa">
      <a href="/lang/id" class="<%= ((typeof lang !== 'undefined' ? lang : 'id') === 'id') ? 'active' : '' %>">ID</a>
      <a href="/lang/en" class="<%= ((typeof lang !== 'undefined' ? lang : 'id') === 'en') ? 'active' : '' %>">EN</a>
    </div>
    <button class="sb-close btn btn-g btn-icon btn-sm" onclick="toggleSidebar()" aria-label="<%= t('common.close', 'Tutup') %>"><i class="bi bi-x-lg"></i></button>
  </div>
  <nav class="sb-nav" aria-label="Menu Utama">
    <% if (typeof multiRouterMode !== 'undefined' && multiRouterMode && allActiveRouters && allActiveRouters.length > 0) { %>
      <div class="sb-router">
        <div class="sb-router-label"><i class="bi bi-router"></i> <%= t('admin.nav.active_router', 'Router Aktif') %></div>
        <select class="fs" style="padding:6px 10px;font-size:12px" aria-label="Filter Router" onchange="window.location.href='/admin/set-active-router?router_id=' + this.value">
          <option value="all" <%= (!selectedRouterId) ? 'selected' : '' %>><%= t('admin.nav.all_routers', 'Semua Router') %> (<%= allActiveRouters.length %>)</option>
          <% allActiveRouters.forEach(r => { %>
            <option value="<%= r.id %>" <%= (selectedRouterId === r.id) ? 'selected' : '' %>>
              <%= r.name %> (<%= r.host %>)
            </option>
          <% }) %>
        </select>
      </div>
    <% } %>
    <ul class="menu">
      <% (sidebarSections || []).forEach((section) => { %>
        <li class="menu-title"><%= section.labelKey ? t(section.labelKey, section.labelDefault) : section.labelDefault %></li>
        <% section.items.forEach((item) => { %>
          <% const isActive = (item.activePages || []).includes(activePage); %>
          <li>
            <a
              href="<%= item.hrefResolved %>"
              class="<%= isActive ? 'active' : '' %>"
              <%- isActive ? 'aria-current="page"' : '' %>
            >
              <i class="<%= item.icon %>"></i>
              <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
            </a>
          </li>
        <% }) %>
      <% }) %>

      <li class="menu-title"><%= t('admin.section.control', 'Kontrol') %></li>
      <% if (typeof session !== 'undefined' && session && session.isAdmin) { %>
      <li>
        <a href="/admin/sidebar-settings" <%- activePage === 'sidebar_settings' ? 'aria-current="page" class="active"' : '' %>>
          <i class="bi bi-layout-sidebar-inset"></i><span><%= t('admin.nav.sidebar_settings', 'Pengaturan Sidebar') %></span>
        </a>
      </li>
      <% } %>
      <li>
        <a href="/admin/logout" class="text-error">
          <i class="bi bi-box-arrow-left"></i><span><%= t('common.logout', 'Logout') %></span>
        </a>
      </li>
    </ul>
    <div class="sb-credit">
      <a href="https://github.com/alijayanet/billing-rtrw" target="_blank" rel="noopener">ALIJAYA BILLING SYSTEM</a>
    </div>
  </nav>
</aside>

<script>
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    if (window.innerWidth > 992) {
      document.body.classList.toggle('sb-collapsed');
    } else if (sb && ov) {
      sb.classList.toggle('open');
      ov.classList.toggle('show');
    }
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      document.querySelectorAll('.mo.show').forEach(function(m) {
        m.classList.remove('show');
      });
      document.querySelectorAll('.modal-overlay').forEach(function(m) {
        if (m.style.display === 'flex' || m.style.display === 'block') {
          m.style.display = 'none';
        }
      });
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && sb.classList.contains('open')) {
        sb.classList.remove('open');
        if (ov) ov.classList.remove('show');
      }
    }
  });

  // Simpan & pulihkan posisi scroll sidebar agar tidak balik ke atas saat pindah halaman / refresh.
  (function () {
    const KEY = 'admin.sidebar.scrollTop';
    const sb = document.getElementById('sidebar');
    if (!sb) return;

    let saveTimer = null;
    sb.addEventListener('scroll', function () {
      if (saveTimer) return;
      saveTimer = setTimeout(function () {
        saveTimer = null;
        try { localStorage.setItem(KEY, String(sb.scrollTop)); } catch (e) {}
      }, 150);
    });

    function restore() {
      let saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) {}
      if (saved !== null && saved !== '') {
        sb.scrollTop = parseInt(saved, 10) || 0;
      } else {
        const active = sb.querySelector('a.active, a[aria-current="page"]');
        if (active) {
          try { active.scrollIntoView({ block: 'nearest' }); } catch (e) {}
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', restore);
    } else {
      restore();
    }
  })();
</script>

<!-- Bottom Navigation (Mobile Only) -->
<nav class="bottom-nav" id="bottomNav">
  <% (sidebarBottomNavItems || []).slice(0, 4).forEach((item) => { %>
    <% const navActive = (item.activePages || []).includes(activePage); %>
    <a
      href="<%= item.hrefResolved %>"
      class="bn-item <%= navActive ? 'active' : '' %>"
      <%- navActive ? 'aria-current="page"' : '' %>
    >
      <i class="<%= item.icon %>"></i>
      <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
    </a>
  <% }) %>
  <button class="bn-item" onclick="toggleSidebar()">
    <i class="bi bi-grid-3x3-gap"></i>
    <span><%= t('common.menu', 'Menu') %></span>
  </button>
</nav>
