<!-- views/admin/partials/sidebar.ejs -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
<aside class="sidebar" id="sidebar">
  <div class="sb-brand">
    <div class="sb-icon"><i class="bi bi-wifi"></i></div>
    <div style="flex:1;min-width:0">
      <div class="sb-name">
        <%= company %>
      </div>
      <div class="sb-sub"><%= t('admin.panel', 'Admin Panel') %></div>
      <div class="sb-lang">
        <a href="/lang/id" class="btn btn-xs <%= ((typeof lang !== 'undefined' ? lang : 'id') === 'id') ? 'btn-primary' : 'btn-ghost' %>">ID</a>
        <a href="/lang/en" class="btn btn-xs <%= ((typeof lang !== 'undefined' ? lang : 'id') === 'en') ? 'btn-primary' : 'btn-ghost' %>">EN</a>
      </div>
      <% if (typeof multiRouterMode !== 'undefined' && multiRouterMode && allActiveRouters && allActiveRouters.length > 0) { %>
        <div class="sb-router">
          <div class="sb-router-label"><i class="bi bi-router"></i> Router Filter</div>
          <select class="select select-sm w-full" onchange="window.location.href='/admin/set-active-router?router_id=' + this.value">
            <option value="all" <%= (!selectedRouterId) ? 'selected' : '' %>>Semua Router (<%= allActiveRouters.length %>)</option>
            <% allActiveRouters.forEach(r => { %>
              <option value="<%= r.id %>" <%= (selectedRouterId === r.id) ? 'selected' : '' %>>
                <%= r.name %> (<%= r.host %>)
              </option>
            <% }) %>
          </select>
        </div>
      <% } %>
    </div>
    <button class="sb-close btn btn-ghost btn-sm btn-square" onclick="toggleSidebar()" aria-label="<%= t('common.close', 'Tutup') %>"><i class="bi bi-x-lg"></i></button>
  </div>
  <nav class="sb-nav">
    <ul class="menu">
      <% (sidebarSections || []).forEach((section) => { %>
        <li class="menu-title"><%= section.labelKey ? t(section.labelKey, section.labelDefault) : section.labelDefault %></li>
        <% section.items.forEach((item) => { %>
          <% const isActive = (item.activePages || []).includes(activePage); %>
          <li>
            <a
              href="<%= item.hrefResolved %>"
              class="<%= isActive ? 'font-semibold' : '' %>"
              <%- isActive ? 'aria-current="page"' : '' %>
              <% if (item.locked) { %>
                onclick='return showLockedMenuNotice(<%- JSON.stringify(item.lockedMessage) %>)'
              <% } %>
            >
              <i class="<%= item.icon %>"></i>
              <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
              <% if (item.locked) { %>
                <span class="badge badge-warning badge-sm">Kunci</span>
              <% } %>
            </a>
          </li>
        <% }) %>
      <% }) %>

      <li class="menu-title">Kontrol</li>
      <li>
        <a href="/admin/sidebar-settings" <%- activePage === 'sidebar_settings' ? 'aria-current="page" class="font-semibold"' : '' %>>
          <i class="bi bi-layout-sidebar-inset"></i><span>Pengaturan Sidebar</span>
        </a>
      </li>
      <li>
        <a href="/admin/logout" class="text-error">
          <i class="bi bi-box-arrow-left"></i><span><%= t('common.logout', 'Logout') %></span>
        </a>
      </li>
    </ul>
    <div class="sb-credit">
      <a href="https://github.com/alijayanet/billing-rtrw" target="_blank" rel="noopener">ALIJAYA BILLING SYSTEM</a>
    </div>
  </nav>
</aside>

<div id="lockedMenuModal" class="modal">
  <div class="modal-box">
    <h3 class="text-base font-bold flex items-center gap-2">
      <i class="bi bi-lock-fill text-warning"></i> Menu Terkunci
    </h3>
    <p class="py-2 text-sm text-base-content/70">Aktivasi diperlukan untuk membuka fitur ini.</p>
    <p id="lockedMenuModalMessage" class="text-sm">Menu ini sedang terkunci.</p>
    <div class="alert alert-info alert-soft mt-4 text-sm">
      Dukung pengembangan aplikasi untuk mendapatkan kode aktivasi (seikhlasnya).
    </div>
    <div class="modal-action">
      <a href="https://app.alijaya.com/donasi" target="_blank" rel="noopener" class="btn btn-warning">
        <i class="bi bi-heart-fill"></i> Donasi &amp; Dapatkan Kode Aktivasi
      </a>
      <a href="/admin/sidebar-settings" class="btn btn-ghost" onclick="hideLockedMenuNotice()">
        <i class="bi bi-layout-sidebar-inset"></i> Pengaturan Sidebar
      </a>
      <button type="button" class="btn btn-primary" onclick="hideLockedMenuNotice()">
        <i class="bi bi-check2-circle"></i> Mengerti
      </button>
    </div>
  </div>
  <div class="modal-backdrop" onclick="hideLockedMenuNotice()"></div>
</div>

<script>
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    sb.classList.toggle('open');
    ov.classList.toggle('show');
  }

  function showLockedMenuNotice(message) {
    const modal = document.getElementById('lockedMenuModal');
    const messageBox = document.getElementById('lockedMenuModalMessage');
    if (messageBox) {
      messageBox.textContent = message || 'Menu ini sedang terkunci.';
    }
    if (modal) {
      modal.classList.add('modal-open');
      document.body.style.overflow = 'hidden';
    }
    return false;
  }

  function hideLockedMenuNotice() {
    const modal = document.getElementById('lockedMenuModal');
    if (modal) {
      modal.classList.remove('modal-open');
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') hideLockedMenuNotice();
  });
</script>

<!-- Bottom Navigation (Mobile Only) -->
<nav class="bottom-nav" id="bottomNav">
  <% (sidebarBottomNavItems || []).slice(0, 4).forEach((item) => { %>
    <% const navActive = (item.activePages || []).includes(activePage); %>
    <a
      href="<%= item.hrefResolved %>"
      class="bn-item <%= navActive ? 'active' : '' %>"
      <%- navActive ? 'aria-current="page"' : '' %>
      <% if (item.locked) { %>
        onclick='return showLockedMenuNotice(<%- JSON.stringify(item.lockedMessage) %>)'
      <% } %>
    >
      <i class="<%= item.icon %>"></i>
      <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
    </a>
  <% }) %>
  <button class="bn-item" onclick="toggleSidebar()">
    <i class="bi bi-grid-3x3-gap"></i>
    <span><%= t('common.menu', 'Menu') %></span>
  </button>
</nav>
