<script id="routers-data" type="application/json"><%- JSON.stringify(routers) %></script>
<script>
const routersData = JSON.parse(document.getElementById('routers-data').textContent);
let currentModalRouterId = null;
let currentModalData = null;

const I18N = {
  testConfirm: "<%= t('admin.routers.confirm.test', 'Test koneksi ke router ini?') %>",
  systemError: "<%= t('admin.routers.js.system_error', 'Terjadi kesalahan sistem.') %>"
};

function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}

function switchView(mode) {
  const gridBtn = document.getElementById('btn-view-grid');
  const tableBtn = document.getElementById('btn-view-table');
  const gridContainer = document.getElementById('view-grid-container');
  const tableContainer = document.getElementById('view-table-container');

  if (mode === 'grid') {
    gridBtn.classList.add('active');
    tableBtn.classList.remove('active');
    gridContainer.style.display = 'grid';
    tableContainer.style.display = 'none';
  } else {
    tableBtn.classList.add('active');
    gridBtn.classList.remove('active');
    gridContainer.style.display = 'none';
    tableContainer.style.display = 'block';
  }
}

function formatBytes(bytes) {
  if (!bytes || bytes === 0) return '0 MB';
  const mb = bytes / (1024 * 1024);
  return mb >= 1024 ? (mb / 1024).toFixed(1) + ' GB' : mb.toFixed(0) + ' MB';
}

async function loadRouterLiveSummary(r) {
  try {
    const res = await fetch('/admin/api/routers/' + r.id + '/details');
    const data = await res.json();
    if (!data.success || !data.live) return;

    const live = data.live;
    const pill = document.getElementById('status-pill-' + r.id);
    const cpuLbl = document.getElementById('cpu-load-lbl-' + r.id);
    const cpuBar = document.getElementById('cpu-load-bar-' + r.id);
    const ramLbl = document.getElementById('ram-usage-lbl-' + r.id);
    const ramBar = document.getElementById('ram-usage-bar-' + r.id);
    const specCust = document.getElementById('spec-cust-' + r.id);
    const specPppoe = document.getElementById('spec-pppoe-' + r.id);
    const specHs = document.getElementById('spec-hs-' + r.id);

    if (pill) {
      if (live.connected) {
        pill.className = 'rc-status-pill online';
        pill.innerHTML = '<span class="rc-status-dot"></span> Online';
      } else {
        pill.className = 'rc-status-pill offline';
        pill.innerHTML = '<span class="rc-status-dot"></span> Offline';
      }
    }

    if (specCust) specCust.textContent = live.customersCount || 0;
    if (specPppoe) specPppoe.textContent = live.activePppoe || 0;
    if (specHs) specHs.textContent = live.activeHotspot || 0;

    if (live.connected) {
      const cpu = live.cpuLoad || 0;
      if (cpuLbl) cpuLbl.textContent = cpu + '%';
      if (cpuBar) {
        cpuBar.style.width = cpu + '%';
        cpuBar.className = 'rc-progress-bar ' + (cpu > 80 ? 'bg-red' : (cpu > 50 ? 'bg-yellow' : 'bg-green'));
      }

      if (live.totalMemory > 0) {
        const usedMem = live.totalMemory - live.freeMemory;
        const memPercent = Math.round((usedMem / live.totalMemory) * 100);
        if (ramLbl) ramLbl.textContent = formatBytes(usedMem) + ' / ' + formatBytes(live.totalMemory);
        if (ramBar) {
          ramBar.style.width = memPercent + '%';
          ramBar.className = 'rc-progress-bar ' + (memPercent > 85 ? 'bg-red' : (memPercent > 65 ? 'bg-yellow' : 'bg-green'));
        }
      }
    }
  } catch (e) {}
}

function switchModalTab(tabName) {
  const tabs = ['sys', 'pppoe', 'hs'];
  tabs.forEach(t => {
    const btn = document.getElementById('mtab-btn-' + t);
    const content = document.getElementById('mtab-content-' + t);
    if (btn) btn.classList.toggle('active', t === tabName);
    if (content) content.style.display = (t === tabName) ? 'block' : 'none';
  });
}

async function openLiveDetailModal(id) {
  currentModalRouterId = id;
  const router = routersData.find(r => r.id === id);
  const nameEl = document.getElementById('modal-router-name');
  const bodyEl = document.getElementById('modal-router-body');

  if (nameEl) nameEl.textContent = 'Detail Router: ' + (router ? router.name : '#' + id);
  bodyEl.innerHTML = `
    <div class="text-center py-5 text-muted">
      <i class="bi bi-arrow-repeat spin fs-2 mb-2 d-block text-primary"></i>
      <span>Mengambil metrik sistem & sesi live dari MikroTik...</span>
    </div>
  `;
  openModal('routerLiveModal');

  try {
    const res = await fetch('/admin/api/routers/' + id + '/details');
    const data = await res.json();

    if (!data.success) throw new Error(data.error || 'Gagal mengambil data router');
    currentModalData = data;
    const l = data.live;
    const r = data.router;

    const usedMem = l.totalMemory - l.freeMemory;
    const memPercent = l.totalMemory > 0 ? Math.round((usedMem / l.totalMemory) * 100) : 0;
    const usedHdd = l.totalHdd - l.freeHdd;
    const hddPercent = l.totalHdd > 0 ? Math.round((usedHdd / l.totalHdd) * 100) : 0;

    const pppoeRows = (l.activePppoeList || []).map((p, idx) => `
      <tr>
        <td class="text-muted">${idx + 1}</td>
        <td class="fw-bold" style="color:var(--text)">${p.name}</td>
        <td class="text-info font-monospace">${p.address}</td>
        <td class="text-warning">${p.uptime}</td>
        <td class="text-muted font-monospace">${p.callerId}</td>
      </tr>
    `).join('');

    const hsRows = (l.activeHotspotList || []).map((h, idx) => `
      <tr>
        <td class="text-muted">${idx + 1}</td>
        <td class="fw-bold" style="color:var(--text)">${h.user}</td>
        <td class="text-info font-monospace">${h.address}</td>
        <td class="text-muted font-monospace">${h.mac}</td>
        <td class="text-warning">${h.uptime}</td>
      </tr>
    `).join('');

    bodyEl.innerHTML = `
      <!-- Top Overview Header -->
      <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3" style="background:var(--bg3); border:1px solid var(--border);">
        <div>
          <h5 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color:var(--text)">
            <i class="bi bi-hdd-network text-info"></i> ${r.name}
          </h5>
          <span class="small text-muted font-monospace">${r.host}:${r.port} | User: ${r.user}</span>
        </div>
        <div>
          ${l.connected 
            ? '<span class="rc-status-pill online"><span class="rc-status-dot"></span> Online / Connected</span>' 
            : '<span class="rc-status-pill offline"><span class="rc-status-dot"></span> Disconnected</span>'}
        </div>
      </div>

      ${l.error ? `<div class="alert alert-d mb-3"><i class="bi bi-exclamation-triangle"></i> Error: ${l.error}</div>` : ''}

      <!-- Modal Internal Tabs Navigation -->
      <div class="d-flex gap-2 mb-3 pb-2" style="border-bottom:1px solid var(--border)">
        <button type="button" class="modal-tab-btn active" id="mtab-btn-sys" onclick="switchModalTab('sys')">
          <i class="bi bi-cpu me-1"></i> Sistem & Metrik
        </button>
        <button type="button" class="modal-tab-btn" id="mtab-btn-pppoe" onclick="switchModalTab('pppoe')">
          <i class="bi bi-plug me-1"></i> PPPoE Aktif (${l.activePppoe})
        </button>
        <button type="button" class="modal-tab-btn" id="mtab-btn-hs" onclick="switchModalTab('hs')">
          <i class="bi bi-wifi me-1"></i> Hotspot Aktif (${l.activeHotspot})
        </button>
      </div>

      <!-- Tab 1: System Metrics & Specs -->
      <div id="mtab-content-sys">
        <div class="row g-2 mb-3">
          <div class="col-4">
            <div class="p-3 text-center rounded-3" style="background:var(--bg3); border:1px solid var(--border)">
              <small class="text-muted d-block uppercase fw-bold mb-1" style="font-size:10px;">CPU Load</small>
              <h4 class="fw-extrabold mb-0 ${l.cpuLoad > 80 ? 'text-danger' : (l.cpuLoad > 50 ? 'text-warning' : 'text-success')}">${l.cpuLoad}%</h4>
            </div>
          </div>
          <div class="col-4">
            <div class="p-3 text-center rounded-3" style="background:var(--bg3); border:1px solid var(--border)">
              <small class="text-muted d-block uppercase fw-bold mb-1" style="font-size:10px;">RAM Used</small>
              <h4 class="fw-extrabold mb-0 text-info">${memPercent}%</h4>
              <small class="text-muted" style="font-size:10px;">${formatBytes(usedMem)} / ${formatBytes(l.totalMemory)}</small>
            </div>
          </div>
          <div class="col-4">
            <div class="p-3 text-center rounded-3" style="background:var(--bg3); border:1px solid var(--border)">
              <small class="text-muted d-block uppercase fw-bold mb-1" style="font-size:10px;">Disk Storage</small>
              <h4 class="fw-extrabold mb-0 text-warning">${hddPercent}%</h4>
              <small class="text-muted" style="font-size:10px;">${formatBytes(usedHdd)} / ${formatBytes(l.totalHdd)}</small>
            </div>
          </div>
        </div>

        <div class="table-responsive rounded-3 mb-3" style="border:1px solid var(--border)">
          <table class="table table-sm table-borderless mb-0 small" style="color:var(--text)">
            <tbody>
              <tr>
                <td class="text-muted ps-3 py-2" style="width:35%;">Identity RouterOS:</td>
                <td class="fw-bold py-2" style="color:var(--text)">${l.identity}</td>
              </tr>
              <tr>
                <td class="text-muted ps-3 py-2">Board / Tipe Model:</td>
                <td class="fw-bold text-info py-2">${l.boardName}</td>
              </tr>
              <tr>
                <td class="text-muted ps-3 py-2">RouterOS Version:</td>
                <td class="fw-bold text-success py-2">${l.version}</td>
              </tr>
              <tr>
                <td class="text-muted ps-3 py-2">Spesifikasi CPU:</td>
                <td class="py-2" style="color:var(--text)">${l.architecture} (${l.cpuCount} Core @ ${l.cpuFrequency} MHz)</td>
              </tr>
              <tr>
                <td class="text-muted ps-3 py-2">Router Uptime:</td>
                <td class="fw-bold text-warning py-2">${l.uptime}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="row g-2">
          <div class="col-4">
            <div class="p-2 rounded-3 text-center" style="background:var(--bg3); border:1px solid var(--border)">
              <span class="d-block text-muted" style="font-size:11px;">Pelanggan DB</span>
              <span class="fw-bold fs-5" style="color:var(--text)">${l.customersCount}</span>
            </div>
          </div>
          <div class="col-4">
            <div class="p-2 rounded-3 text-center" style="background:var(--bg3); border:1px solid var(--border)">
              <span class="d-block text-muted" style="font-size:11px;">PPPoE Sesi Aktif</span>
              <span class="fw-bold fs-5 text-success">${l.activePppoe}</span>
            </div>
          </div>
          <div class="col-4">
            <div class="p-2 rounded-3 text-center" style="background:var(--bg3); border:1px solid var(--border)">
              <span class="d-block text-muted" style="font-size:11px;">Hotspot User Aktif</span>
              <span class="fw-bold fs-5 text-warning">${l.activeHotspot}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: PPPoE Active Sessions List -->
      <div id="mtab-content-pppoe" style="display:none;">
        <div class="table-responsive rounded-3" style="max-height: 280px; overflow-y: auto; border:1px solid var(--border);">
          <table class="table table-hover table-sm mb-0 small" style="color:var(--text)">
            <thead class="sticky-top" style="background:var(--bg3)">
              <tr>
                <th>#</th>
                <th>Username</th>
                <th>IP Address</th>
                <th>Uptime</th>
                <th>Caller ID / MAC</th>
              </tr>
            </thead>
            <tbody>
              ${pppoeRows || '<tr><td colspan="5" class="text-center text-muted py-4">Tidak ada sesi PPPoE aktif di router ini</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Tab 3: Hotspot Active Sessions List -->
      <div id="mtab-content-hs" style="display:none;">
        <div class="table-responsive rounded-3" style="max-height: 280px; overflow-y: auto; border:1px solid var(--border);">
          <table class="table table-hover table-sm mb-0 small" style="color:var(--text)">
            <thead class="sticky-top" style="background:var(--bg3)">
              <tr>
                <th>#</th>
                <th>User / Voucher</th>
                <th>IP Address</th>
                <th>MAC Address</th>
                <th>Uptime</th>
              </tr>
            </thead>
            <tbody>
              ${hsRows || '<tr><td colspan="5" class="text-center text-muted py-4">Tidak ada pengguna Hotspot aktif di router ini</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    `;
  } catch (e) {
    bodyEl.innerHTML = `<div class="alert alert-d"><i class="bi bi-exclamation-triangle"></i> ${e.message}</div>`;
  }
}

function refreshCurrentModal() {
  if (currentModalRouterId) openLiveDetailModal(currentModalRouterId);
}

function editRouter(idx) {
  const r = routersData[idx];
  document.getElementById('editForm').action = '/admin/routers/' + r.id + '/update';
  document.getElementById('e_name').value = r.name;
  document.getElementById('e_host').value = r.host;
  document.getElementById('e_port').value = r.port;
  document.getElementById('e_user').value = r.user;
  document.getElementById('e_active').value = r.is_active;
  document.getElementById('e_desc').value = r.description || '';
  openModal('editModal');
}

async function testConn(id) {
  if(!confirm(I18N.testConfirm)) return;
  try {
    const res = await fetch('/admin/api/routers/' + id + '/test');
    const data = await res.json();
    alert(data.success ? '✅ ' + data.message : '❌ ' + data.error);
    loadRouterLiveSummary({ id });
  } catch (e) { alert(I18N.systemError); }
}

function switchIsolirTab(tab) {
  const autoTab = document.getElementById('isolir-tab-auto');
  const scriptTab = document.getElementById('isolir-tab-script');
  const autoBtn = document.getElementById('tab-btn-auto');
  const scriptBtn = document.getElementById('tab-btn-script');
  const copyBtn = document.getElementById('btn-copy-script-modal');

  if (tab === 'auto') {
    autoTab.style.display = 'block';
    scriptTab.style.display = 'none';
    autoBtn.className = 'btn btn-sm btn-p';
    scriptBtn.className = 'btn btn-sm btn-g';
    if (copyBtn) copyBtn.style.display = 'none';
  } else {
    autoTab.style.display = 'none';
    scriptTab.style.display = 'block';
    autoBtn.className = 'btn btn-sm btn-g';
    scriptBtn.className = 'btn btn-sm btn-p';
    if (copyBtn) copyBtn.style.display = 'inline-block';
  }
}

async function setupFirewall(routerId) {
  openIsolirScriptModal(routerId);
  switchIsolirTab('auto');
}

async function openIsolirScriptModal(routerId = null) {
  const ta = document.getElementById('isolir-script-body');
  const meta = document.getElementById('isolir-script-meta');
  const routerSel = document.getElementById('isolir-modal-router-select');
  const statusBox = document.getElementById('isolir-auto-setup-result');
  if (statusBox) statusBox.style.display = 'none';

  if (routerSel && routerId) {
    routerSel.value = String(routerId);
  }

  ta.value = '<%= t('common.loading', 'Memuat...') %>';
  meta.textContent = '';
  openModal('isolirScriptModal');

  try {
    const res = await fetch('/admin/api/isolir-portal-script');
    const data = await res.json();
    if (!data.success) throw new Error(data.error || 'Gagal');
    ta.value = data.script || '';
    meta.textContent = (data.appUrl ? ('app_url: ' + data.appUrl + ' | ') : '') + 'IP Server: ' + (data.billingIp || '-') + ' | NAT → HTTP:' + (data.httpNatPort ?? '-') + ' HTTPS:' + (data.httpsNatPort ?? '-');
  } catch (e) {
    ta.value = '';
    meta.textContent = e.message || 'Error';
  }
}

async function runAutoSetupFirewallFromModal() {
  const routerSel = document.getElementById('isolir-modal-router-select');
  const routerId = routerSel ? routerSel.value : null;
  const statusBox = document.getElementById('isolir-auto-setup-result');
  if (!routerId) {
    alert('Pilih router terlebih dahulu!');
    return;
  }
  
  statusBox.style.display = 'block';
  statusBox.className = 'alert alert-info p-3 small mt-3';
  statusBox.innerHTML = '<i class="bi bi-arrow-repeat spin me-1"></i> Sedang menghubungkan dan memasang rule Firewall/NAT isolir di MikroTik...';

  try {
    const res = await fetch('/admin/api/routers/' + routerId + '/setup-firewall', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      statusBox.className = 'alert alert-success p-3 small mt-3';
      statusBox.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> <strong>BERHASIL:</strong> ' + data.message;
    } else {
      statusBox.className = 'alert alert-danger p-3 small mt-3';
      statusBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>GAGAL:</strong> ' + (data.error || data.message || 'Terjadi kesalahan');
    }
  } catch (e) {
    statusBox.className = 'alert alert-danger p-3 small mt-3';
    statusBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>ERROR:</strong> ' + e.message;
  }
}

function copyIsolirScript() {
  const ta = document.getElementById('isolir-script-body');
  if (!ta || !ta.value) return;
  ta.select();
  document.execCommand('copy');
  alert('<%= t('admin.routers.isolir_script_copied', 'Script disalin ke clipboard.') %>');
}

// Auto load metrics for all routers on page load
window.addEventListener('DOMContentLoaded', () => {
  routersData.forEach(r => {
    loadRouterLiveSummary(r);
  });
});
</script>
</body>
</html>
