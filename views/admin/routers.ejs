<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.router_management', 'Manajemen Router') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .mtabs { display: flex; gap: 10px; margin-bottom: 18px; border-bottom: 1px solid var(--border); padding-bottom: 12px; }
    .mtab { padding: 9px 16px; border-radius: 10px; cursor: pointer; color: var(--muted); transition: all 0.2s; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 8px; }
    .mtab:hover { background: rgba(0,0,0,0.05); color: var(--text); }
    .mtab.active { background: var(--primary); color: white; }

    /* Router Grid Cards */
    .router-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }

    .rc-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
      transition: border-color .2s ease, box-shadow .2s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .rc-card:hover {
      border-color: var(--primary);
      box-shadow: 0 6px 20px -8px rgba(16, 24, 40, .18);
    }

    .rc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 16px;
    }

    .rc-title-box {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .rc-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: var(--pdim);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      border: 1px solid var(--pdim);
    }

    .rc-name {
      font-size: 17px;
      font-weight: 700;
      color: var(--text);
      margin: 0;
      line-height: 1.2;
    }

    .rc-host {
      font-size: 12px;
      color: var(--muted);
      font-family: ui-monospace, monospace;
      margin-top: 3px;
    }

    .rc-status-pill {
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      letter-spacing: 0.3px;
    }
    .rc-status-pill.online {
      background: var(--sdim);
      color: var(--success);
      border: 1px solid var(--sdim);
    }
    .rc-status-pill.offline {
      background: var(--ddim);
      color: var(--danger);
      border: 1px solid var(--ddim);
    }
    .rc-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }
    .rc-status-pill.online .rc-status-dot {
      background: var(--success);
    }
    .rc-status-pill.offline .rc-status-dot {
      background: var(--danger);
    }

    /* Meter Bars */
    .rc-metrics {
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: var(--bg3);
      border-radius: 12px;
      padding: 14px;
      border: 1px solid var(--border);
      margin-bottom: 16px;
    }

    .rc-metric-item {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .rc-metric-head {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--muted);
      font-weight: 700;
    }

    .rc-progress {
      height: 7px;
      background: rgba(0, 0, 0, 0.08);
      border-radius: 10px;
      overflow: hidden;
    }

    .rc-progress-bar {
      height: 100%;
      border-radius: 10px;
      transition: width 0.6s ease;
    }
    .bg-green { background: var(--success); }
    .bg-yellow { background: var(--warning); }
    .bg-red { background: var(--danger); }

    /* Specs Badges */
    .rc-specs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 18px;
      text-align: center;
    }

    .rc-spec-box {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 4px;
    }
    .rc-spec-val {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
    }
    .rc-spec-lbl {
      font-size: 10px;
      color: var(--muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 2px;
    }

    .rc-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid var(--border);
    }

    .btn-detail-live {
      background: var(--primary);
      color: #fff !important;
      border: none;
      border-radius: 8px;
      padding: 8px 14px;
      font-weight: 600;
      font-size: 13px;
      transition: filter .2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .btn-detail-live:hover {
      filter: brightness(.95);
    }

    .view-toggle-btn {
      padding: 6px 14px;
      border-radius: 8px;
      background: var(--bg3);
      color: var(--text);
      border: 1px solid var(--border);
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
    }
    .view-toggle-btn.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    /* Modal Styling Improvements */
    .modal-tab-btn {
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg3);
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .modal-tab-btn:hover {
      background: rgba(0, 0, 0, 0.05);
      color: var(--text);
    }
    .modal-tab-btn.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'mikrotik', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-hdd-network"></i> <%= t('admin.nav.router_management', 'Manajemen Router') %>
    </div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">
    <% const mTab = 'routers'; %>

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type === 'success' ? 's' : 'd' %>">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <%- include('partials/tabs_mikrotik', { mTab: 'routers' }) %>

    <!-- Header Actions & View Mode -->
    <div class="card mb-3" style="border:none; background:transparent;">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <h5 class="fw-bold mb-0" style="color:var(--text)"><i class="bi bi-cpu text-primary me-2"></i>Daftar Router MikroTik (<%= routers.length %>)</h5>
        </div>
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
          <div class="d-flex gap-1 p-1 rounded-3" style="background:var(--bg2); border:1px solid var(--border);">
            <button type="button" class="view-toggle-btn active" id="btn-view-grid" onclick="switchView('grid')"><i class="bi bi-grid-fill me-1"></i> Grid Kartu</button>
            <button type="button" class="view-toggle-btn" id="btn-view-table" onclick="switchView('table')"><i class="bi bi-table me-1"></i> Tabel</button>
          </div>
          <button type="button" class="btn btn-g btn-sm" onclick="openIsolirScriptModal()"><i class="bi bi-filetype-txt me-1"></i> Script Isolir</button>
          <button class="btn btn-p btn-sm" onclick="openModal('addModal')"><i class="bi bi-plus-lg me-1"></i> Tambah Router</button>
        </div>
      </div>
    </div>

    <!-- View 1: Modern Router Grid Cards -->
    <div id="view-grid-container" class="router-grid">
      <% if (routers.length === 0) { %>
        <div class="card p-4 text-center text-muted" style="grid-column: 1 / -1;">
          <i class="bi bi-hdd-network fs-1 mb-2"></i>
          <h6><%= t('admin.routers.empty', 'Belum ada router yang ditambahkan') %></h6>
          <button class="btn btn-p btn-sm mt-2" onclick="openModal('addModal')"><i class="bi bi-plus-lg me-1"></i> Tambah Router Sekarang</button>
        </div>
      <% } %>

      <% routers.forEach((r, i) => { %>
        <div class="rc-card" id="router-card-<%= r.id %>">
          <div>
            <div class="rc-header">
              <div class="rc-title-box">
                <div class="rc-icon"><i class="bi bi-router-fill"></i></div>
                <div>
                  <h6 class="rc-name"><%= r.name %></h6>
                  <div class="rc-host"><%= r.host %>:<%= r.port %></div>
                </div>
              </div>
              <div>
                <% if (r.is_active) { %>
                  <span class="rc-status-pill online" id="status-pill-<%= r.id %>"><span class="rc-status-dot"></span> Aktif</span>
                <% } else { %>
                  <span class="rc-status-pill offline" id="status-pill-<%= r.id %>"><span class="rc-status-dot"></span> Nonaktif</span>
                <% } %>
              </div>
            </div>

            <!-- Live Metrics (Loaded via JS) -->
            <div class="rc-metrics" id="metrics-box-<%= r.id %>">
              <div class="rc-metric-item">
                <div class="rc-metric-head">
                  <span><i class="bi bi-speedometer2 me-1"></i> CPU Load</span>
                  <span id="cpu-load-lbl-<%= r.id %>">--%</span>
                </div>
                <div class="rc-progress">
                  <div class="rc-progress-bar bg-green" id="cpu-load-bar-<%= r.id %>" style="width: 0%;"></div>
                </div>
              </div>

              <div class="rc-metric-item">
                <div class="rc-metric-head">
                  <span><i class="bi bi-memory me-1"></i> RAM Usage</span>
                  <span id="ram-usage-lbl-<%= r.id %>">-- MB</span>
                </div>
                <div class="rc-progress">
                  <div class="rc-progress-bar bg-yellow" id="ram-usage-bar-<%= r.id %>" style="width: 0%;"></div>
                </div>
              </div>
            </div>

            <!-- System Specs & Active Stats -->
            <div class="rc-specs">
              <div class="rc-spec-box">
                <div class="rc-spec-val text-info" id="spec-cust-<%= r.id %>">-</div>
                <div class="rc-spec-lbl">Pelanggan</div>
              </div>
              <div class="rc-spec-box">
                <div class="rc-spec-val text-success" id="spec-pppoe-<%= r.id %>">-</div>
                <div class="rc-spec-lbl">PPPoE Aktif</div>
              </div>
              <div class="rc-spec-box">
                <div class="rc-spec-val text-warning" id="spec-hs-<%= r.id %>">-</div>
                <div class="rc-spec-lbl">Hotspot</div>
              </div>
            </div>
          </div>

          <div class="rc-actions">
            <button type="button" class="btn-detail-live flex-fill" title="Detail Live Status" onclick="openLiveDetailModal(<%= r.id %>)">
              <i class="bi bi-cpu-fill me-1"></i> Detail Live
            </button>
            <button type="button" class="btn btn-g btn-sm" title="<%= t('admin.routers.actions.test', 'Test Koneksi') %>" onclick="testConn(<%= r.id %>)">
              <i class="bi bi-plug"></i>
            </button>
            <button type="button" class="btn btn-g btn-sm" title="Setup Firewall Isolir" onclick="setupFirewall(<%= r.id %>)">
              <i class="bi bi-shield-lock"></i>
            </button>
            <button type="button" class="btn btn-g btn-sm" title="<%= t('common.edit', 'Edit') %>" onclick="editRouter(<%= i %>)">
              <i class="bi bi-pencil"></i>
            </button>
            <button type="button" class="btn btn-d btn-sm" title="<%= t('common.delete', 'Hapus') %>" onclick="openDeleteRouterModal(<%= r.id %>)"><i class="bi bi-trash"></i></button>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- View 2: Detailed Table View (Hidden by Default) -->
    <div id="view-table-container" class="card" style="display: none;">
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>#</th>
              <th><%= t('admin.routers.table.name', 'Nama Router') %></th>
              <th><%= t('admin.routers.table.host', 'Host / IP') %></th>
              <th><%= t('admin.routers.table.port', 'Port') %></th>
              <th><%= t('admin.routers.table.username', 'Username') %></th>
              <th><%= t('admin.routers.table.status', 'Status') %></th>
              <th><%= t('common.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
          <% if (routers.length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted" style="padding:32px"><%= t('admin.routers.empty', 'Belum ada router yang ditambahkan') %></td></tr>
          <% } %>
          <% routers.forEach((r, i) => { %>
            <tr>
              <td class="text-muted"><%= i+1 %></td>
              <td class="fw6"><%= r.name %></td>
              <td><%= r.host %></td>
              <td><%= r.port %></td>
              <td><%= r.user %></td>
              <td>
                <% if (r.is_active) { %><span class="badge bs"><%= t('common.active', 'Aktif') %></span><% } else { %><span class="badge bm"><%= t('common.inactive', 'Nonaktif') %></span><% } %>
              </td>
              <td>
                <button class="btn btn-g btn-icon btn-sm" title="Detail Live Status" onclick="openLiveDetailModal(<%= r.id %>)"><i class="bi bi-cpu-fill text-primary"></i></button>
                <button class="btn btn-g btn-icon btn-sm" title="<%= t('admin.routers.actions.test', 'Test Koneksi') %>" onclick="testConn(<%= r.id %>)"><i class="bi bi-plug"></i></button>
                <button class="btn btn-g btn-icon btn-sm" title="Setup Firewall Isolir" onclick="setupFirewall(<%= r.id %>)"><i class="bi bi-shield-lock"></i></button>
                <button class="btn btn-g btn-icon btn-sm" title="<%= t('common.edit', 'Edit') %>" onclick="editRouter(<%= i %>)"><i class="bi bi-pencil"></i></button>
                <button type="button" class="btn btn-d btn-icon btn-sm" title="<%= t('common.delete', 'Hapus') %>" onclick="openDeleteRouterModal(<%= r.id %>)"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>window.__ROUTERS = <%- JSON.stringify((routers || []).map(r => ({ id: r.id, name: r.name, host: r.host || '' }))) %>;</script>

<!-- Modal Hapus Router -->
<div class="mo" id="deleteRouterModal">
  <div class="mb" style="max-width: 520px;">
    <div class="mh">
      <span class="mt"><i class="bi bi-trash text-danger me-2"></i> Hapus Router</span>
      <button class="mc" onclick="closeModal('deleteRouterModal')">&times;</button>
    </div>
    <div class="mbody">
      <p id="del-router-name" style="font-weight:700;margin-bottom:8px"></p>
      <div id="del-usage" class="hint" style="margin-bottom:12px"></div>
      <div id="del-reassign-wrap" style="display:none">
        <label class="fl">Pindahkan pelanggan ke router</label>
        <select class="fs" id="del-reassign"></select>
        <label style="display:flex;gap:8px;align-items:center;margin-top:12px;font-size:13px;cursor:pointer">
          <input type="checkbox" id="del-force" onchange="toggleDelForce()">
          <span>Hapus paksa tanpa memindahkan (pelanggan jadi tanpa router)</span>
        </label>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('deleteRouterModal')">Batal</button>
      <button type="button" class="btn btn-d" onclick="submitDeleteRouter()"><i class="bi bi-trash"></i> Hapus Router</button>
    </div>
  </div>
</div>

<form id="deleteRouterForm" method="POST" style="display:none">
  <input type="hidden" name="reassign_to" id="del-reassign-input">
  <input type="hidden" name="force" id="del-force-input">
</form>

<script>
  let __delRouterId = null;

  async function openDeleteRouterModal(id) {
    __delRouterId = id;
    const router = (window.__ROUTERS || []).find(r => Number(r.id) === Number(id)) || {};
    document.getElementById('del-router-name').textContent = 'Router: ' + (router.name || ('#' + id));

    const sel = document.getElementById('del-reassign');
    const others = (window.__ROUTERS || []).filter(r => Number(r.id) !== Number(id));
    sel.innerHTML = others.length
      ? others.map(r => '<option value="' + r.id + '">' + r.name + (r.host ? ' (' + r.host + ')' : '') + '</option>').join('')
      : '<option value="">(tidak ada router lain)</option>';
    document.getElementById('del-force').checked = false;
    toggleDelForce();

    let usage = {};
    try { usage = await fetch('/admin/api/routers/' + id + '/usage').then(r => r.json()); } catch (e) { usage = {}; }
    const labels = { customers: 'pelanggan', packages: 'paket', agents: 'agent', voucher_batches: 'batch voucher', vouchers: 'voucher', voucher_packages: 'paket voucher' };
    const parts = Object.entries(usage).filter(([, v]) => v > 0).map(([k, v]) => v + ' ' + (labels[k] || k));
    document.getElementById('del-usage').innerHTML = parts.length
      ? ('Dipakai oleh: <strong>' + parts.join(', ') + '</strong>.')
      : 'Tidak ada data yang memakai router ini.';

    const customers = Number(usage.customers || 0);
    const wrap = document.getElementById('del-reassign-wrap');
    wrap.style.display = (customers > 0 && others.length) ? 'block' : 'none';
    openModal('deleteRouterModal');
  }

  function toggleDelForce() {
    const force = document.getElementById('del-force').checked;
    const sel = document.getElementById('del-reassign');
    if (sel) sel.disabled = force;
  }

  function submitDeleteRouter() {
    if (!__delRouterId) return;
    const force = document.getElementById('del-force').checked;
    const sel = document.getElementById('del-reassign');
    document.getElementById('del-force-input').value = force ? '1' : '';
    document.getElementById('del-reassign-input').value = force ? '' : (sel && sel.value ? sel.value : '');
    const f = document.getElementById('deleteRouterForm');
    f.action = '/admin/routers/' + __delRouterId + '/delete';
    f.submit();
  }
</script>

<!-- Modal Live Detail Router -->
<div class="mo" id="routerLiveModal">
  <div class="mb" style="max-width: 740px;">
    <div class="mh">
      <span class="mt"><i class="bi bi-cpu-fill text-primary me-2"></i> <span id="modal-router-name">Detail Live Router</span></span>
      <button class="mc" onclick="closeModal('routerLiveModal')">&times;</button>
    </div>
    <div class="mbody" id="modal-router-body" style="min-height:360px;">
      <div class="text-center py-5 text-muted">
        <i class="bi bi-arrow-repeat spin fs-2 mb-2 d-block text-primary"></i>
        <span>Memuat metrik sistem & data live router...</span>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('routerLiveModal')">Tutup</button>
      <button type="button" id="modal-btn-refresh" class="btn btn-p" onclick="refreshCurrentModal()"><i class="bi bi-arrow-clockwise me-1"></i> Refresh Data</button>
    </div>
  </div>
</div>

<!-- Modal Script & Setup Firewall Isolir Portal -->
<div class="mo" id="isolirScriptModal">
  <div class="mb" style="max-width:740px">
    <div class="mh">
      <span class="mt"><i class="bi bi-shield-lock text-warning me-2"></i> Setup Firewall & Halaman Isolir Pelanggan</span>
      <button class="mc" onclick="closeModal('isolirScriptModal')">&times;</button>
    </div>
    <div class="mbody">
      <!-- Tabs Header -->
      <div class="d-flex gap-2 mb-3 border-bottom pb-2">
        <button type="button" class="btn btn-sm btn-p" id="tab-btn-auto" onclick="switchIsolirTab('auto')">
          <i class="bi bi-lightning-charge-fill me-1"></i> 1-Click Auto Setup (API)
        </button>
        <button type="button" class="btn btn-sm btn-g" id="tab-btn-script" onclick="switchIsolirTab('script')">
          <i class="bi bi-filetype-txt me-1"></i> Copy Script RouterOS (.rsc)
        </button>
      </div>

      <!-- TAB 1: Auto Setup via API -->
      <div id="isolir-tab-auto">
        <div class="alert alert-info p-3 small mb-3" style="background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af;">
          <h6 class="fw-bold mb-1" style="color:#1e40af;"><i class="bi bi-info-circle me-1"></i> Otomatisasi Redirect Halaman Isolir</h6>
          <p class="mb-0 small">
            Sistem akan mengirimkan perintah API ke MikroTik untuk membuat <strong>Rule NAT Redirect (Port 80/443)</strong>, <strong>Firewall Rule (LIST_ISOLIR)</strong>, serta memasang <strong>Hook Script on-up di Profil PPPoE Isolir</strong> secara otomatis.
          </p>
        </div>

        <div class="form-group mb-3">
          <label class="fl fw-bold mb-2" style="color:var(--text)">Pilih Router MikroTik Target *</label>
          <select class="fs w-100" id="isolir-modal-router-select">
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>:<%= r.port %>)</option>
            <% }) %>
          </select>
        </div>

        <button type="button" class="btn btn-primary fw-bold w-100 py-2 shadow-sm" onclick="runAutoSetupFirewallFromModal()">
          <i class="bi bi-play-circle-fill me-1"></i> Jalankan Setup Firewall & Hook Isolir Sekarang
        </button>

        <div id="isolir-auto-setup-result" style="display:none;"></div>
      </div>

      <!-- TAB 2: RouterOS Manual Script (.rsc) -->
      <div id="isolir-tab-script" style="display:none;">
        <p class="small text-muted mb-2">Script ini di-generate otomatis berdasarkan IP server & URL billing (app_url). Anda dapat menyalin dan menempelkannya di Winbox Terminal MikroTik.</p>
        <div id="isolir-script-meta" class="small mb-2 fw-bold" style="color:var(--text);"></div>
        <textarea id="isolir-script-body" class="fc" readonly rows="14" style="width:100%;font-family:ui-monospace,monospace;font-size:12px;background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:8px;"></textarea>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('isolirScriptModal')"><%= t('common.close', 'Tutup') %></button>
      <button type="button" class="btn btn-p" id="btn-copy-script-modal" style="display:none;" onclick="copyIsolirScript()"><i class="bi bi-clipboard me-1"></i> <%= t('admin.routers.isolir_script_copy', 'Salin script') %></button>
    </div>
  </div>
</div>

