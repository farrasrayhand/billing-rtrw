<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Asisten AI | <%= company %></title>
  <meta name="theme-color" content="#f7f8fa">
  <link rel="manifest" href="/admin/manifest.webmanifest">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'ai', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-robot"></i> Asisten AI</div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">
    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <span><%= msg.text %></span>
    </div>
    <% } %>

    <form method="POST" action="/admin/ai/settings">
      <div class="card mb16">
        <div class="card-hd"><h6 style="margin:0"><i class="bi bi-toggles"></i> Aktivasi</h6></div>
        <div class="card-bd">
          <div class="fg">
            <label class="fl">Asisten AI WhatsApp (CS Otomatis)</label>
            <select class="fs" name="whatsapp_ai_enabled">
              <option value="true" <%= settings.whatsapp_ai_enabled === true ? 'selected' : '' %>>Aktif</option>
              <option value="false" <%= settings.whatsapp_ai_enabled !== true ? 'selected' : '' %>>Nonaktif</option>
            </select>
            <div class="hint">Menjawab otomatis pertanyaan pelanggan di WhatsApp.</div>
          </div>
          <div class="fg" style="margin-top:12px">
            <label class="fl">Asisten AI di Grup Telegram</label>
            <div class="hint">Diatur di menu <a href="/admin/telegram" style="font-weight:700;color:var(--primary)">Telegram</a> (bersama token bot, admin ID &amp; sambutan grup).</div>
          </div>
        </div>
      </div>

    <!-- PENGATURAN MESIN AI (SHARED: TELEGRAM & WHATSAPP) -->
    <div class="card mb16">
      <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center">
        <h6><i class="bi bi-robot"></i> Pengaturan Mesin AI (Artificial Intelligence Multi-Provider)</h6>
        <span class="badge" style="background:#0284c7;color:#fff;font-size:11px;padding:3px 8px;border-radius:4px">Telegram & WhatsApp</span>
      </div>
      <div class="card-bd">
        <div class="hint" style="margin-bottom:14px">
          Mesin AI ini digunakan secara otomatis oleh <strong>Telegram Bot</strong> dan <strong>WhatsApp Bot</strong> untuk menjawab tanya jawab pelanggan, melayani pertanyaan umum di luar sistem, serta mengeksekusi perintah operasional admin (cek tagihan, isolir, unisolir, reboot modem ONU, dsb.).
        </div>

        <div class="form-row">
          <div class="fg">
            <label class="fl">Provider AI Utama</label>
            <select class="fs" name="ai_provider" id="ai_provider_select" onchange="toggleAiProviderFields()">
              <option value="gemini" <%= (settings.ai_provider || 'gemini') === 'gemini' ? 'selected' : '' %>>Google Gemini (Gratis, Sangat Cepat & Rekomendasi)</option>
              <option value="openai" <%= settings.ai_provider === 'openai' ? 'selected' : '' %>>OpenAI (ChatGPT - GPT-4o / GPT-4o-mini)</option>
              <option value="deepseek" <%= settings.ai_provider === 'deepseek' ? 'selected' : '' %>>DeepSeek (DeepSeek-V3 / DeepSeek-R1)</option>
              <option value="groq" <%= settings.ai_provider === 'groq' ? 'selected' : '' %>>Groq Cloud (Llama 3.3 Ultra Fast Inference)</option>
              <option value="openrouter" <%= settings.ai_provider === 'openrouter' ? 'selected' : '' %>>OpenRouter (Multi-Model Hub API)</option>
              <option value="custom" <%= settings.ai_provider === 'custom' ? 'selected' : '' %>>Custom / Local AI (Ollama / vLLM / LM Studio)</option>
            </select>
            <div style="font-size:11px;color:var(--muted);margin-top:4px">Pilih penyedia AI yang ingin digunakan untuk bot Telegram & WhatsApp.</div>
          </div>
        </div>

        <!-- Provider: Google Gemini -->
        <div id="ai_fields_gemini" class="ai-provider-field" style="margin-top:12px">
          <div class="form-row">
            <div class="fg">
              <label class="fl">Google Gemini API Key (Gratis)</label>
              <input class="fc" name="gemini_api_key" value="<%= settings.gemini_api_key || '' %>" placeholder="AIzaSy... (dapatkan dari aistudio.google.com)">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan gratis di <strong>aistudio.google.com</strong>. Auto fallback: gemini-2.5-flash / gemini-2.0-flash. Kosongkan jika ingin mode offline.</div>
            </div>
            <div class="fg">
              <label class="fl">Model Gemini</label>
              <input class="fc" name="gemini_model" value="<%= settings.gemini_model || 'gemini-3.5-flash-lite' %>">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Default: <span class="mono">gemini-3.5-flash-lite</span></div>
            </div>
          </div>
        </div>

        <!-- Provider: OpenAI -->
        <div id="ai_fields_openai" class="ai-provider-field" style="margin-top:12px; display:none">
          <div class="form-row">
            <div class="fg">
              <label class="fl">OpenAI API Key</label>
              <input class="fc" type="password" name="openai_api_key" value="<%= settings.openai_api_key || '' %>" placeholder="sk-proj-...">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan dari platform.openai.com/api-keys</div>
            </div>
            <div class="fg">
              <label class="fl">Model OpenAI</label>
              <input class="fc" name="openai_model" value="<%= settings.openai_model || 'gpt-4o-mini' %>" placeholder="gpt-4o-mini">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">gpt-4o-mini</span> atau <span class="mono">gpt-4o</span></div>
            </div>
          </div>
        </div>

        <!-- Provider: DeepSeek -->
        <div id="ai_fields_deepseek" class="ai-provider-field" style="margin-top:12px; display:none">
          <div class="form-row">
            <div class="fg">
              <label class="fl">DeepSeek API Key</label>
              <input class="fc" type="password" name="deepseek_api_key" value="<%= settings.deepseek_api_key || '' %>" placeholder="sk-...">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan dari platform.deepseek.com</div>
            </div>
            <div class="fg">
              <label class="fl">Model DeepSeek</label>
              <input class="fc" name="deepseek_model" value="<%= settings.deepseek_model || 'deepseek-chat' %>" placeholder="deepseek-chat">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">deepseek-chat</span> (V3) atau <span class="mono">deepseek-reasoner</span> (R1)</div>
            </div>
          </div>
        </div>

        <!-- Provider: Groq -->
        <div id="ai_fields_groq" class="ai-provider-field" style="margin-top:12px; display:none">
          <div class="form-row">
            <div class="fg">
              <label class="fl">Groq API Key (Inference Sangat Cepat)</label>
              <input class="fc" type="password" name="groq_api_key" value="<%= settings.groq_api_key || '' %>" placeholder="gsk_...">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan gratis di console.groq.com/keys</div>
            </div>
            <div class="fg">
              <label class="fl">Model Groq</label>
              <input class="fc" name="groq_model" value="<%= settings.groq_model || 'llama-3.3-70b-versatile' %>" placeholder="llama-3.3-70b-versatile">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">llama-3.3-70b-versatile</span></div>
            </div>
          </div>
        </div>

        <!-- Provider: OpenRouter -->
        <div id="ai_fields_openrouter" class="ai-provider-field" style="margin-top:12px; display:none">
          <div class="form-row">
            <div class="fg">
              <label class="fl">OpenRouter API Key</label>
              <input class="fc" type="password" name="openrouter_api_key" value="<%= settings.openrouter_api_key || '' %>" placeholder="sk-or-v1-...">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan dari openrouter.ai/keys</div>
            </div>
            <div class="fg">
              <label class="fl">Model OpenRouter</label>
              <input class="fc" name="openrouter_model" value="<%= settings.openrouter_model || 'meta-llama/llama-3.3-70b-instruct' %>" placeholder="meta-llama/llama-3.3-70b-instruct">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">meta-llama/llama-3.3-70b-instruct</span></div>
            </div>
          </div>
        </div>

        <!-- Provider: Custom / Local AI -->
        <div id="ai_fields_custom" class="ai-provider-field" style="margin-top:12px; display:none">
          <div class="form-row">
            <div class="fg">
              <label class="fl">API Base URL (OpenAI-Compatible Endpoint)</label>
              <input class="fc" name="custom_ai_base_url" value="<%= settings.custom_ai_base_url || '' %>" placeholder="http://localhost:11434/v1">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh Ollama: <span class="mono">http://localhost:11434/v1</span> | LM Studio: <span class="mono">http://localhost:1234/v1</span></div>
            </div>
            <div class="fg">
              <label class="fl">Nama Model</label>
              <input class="fc" name="custom_ai_model" value="<%= settings.custom_ai_model || '' %>" placeholder="llama3:latest">
              <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">llama3</span>, <span class="mono">qwen2.5</span>, atau <span class="mono">mistral</span></div>
            </div>
          </div>
          <div class="form-row" style="margin-top:10px">
            <div class="fg">
              <label class="fl">API Key (Opsional)</label>
              <input class="fc" type="password" name="custom_ai_api_key" value="<%= settings.custom_ai_api_key || '' %>" placeholder="Kosongkan jika Ollama lokal tanpa password/auth">
            </div>
          </div>
        </div>

      </div>
    </div>

      <div style="display:flex;justify-content:flex-end;gap:10px">
        <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan Pengaturan AI</button>
      </div>
    </form>

    <div class="card mb16" style="margin-top:16px">
      <div class="card-hd"><h6 style="margin:0"><i class="bi bi-chat-dots"></i> Tes AI</h6></div>
      <div class="card-bd">
        <form method="POST" action="/admin/ai/test">
          <div class="fg">
            <label class="fl">Pertanyaan</label>
            <textarea class="fc" name="question" rows="3" placeholder="Contoh: bagaimana cara isolir pelanggan? atau berapa tagihan bulan ini?"><%= (aiTest && aiTest.question) ? aiTest.question : '' %></textarea>
          </div>
          <div style="display:flex;justify-content:flex-end;margin-top:10px">
            <button type="submit" class="btn btn-p btn-sm"><i class="bi bi-send"></i> Tes Jawab</button>
          </div>
        </form>

        <% if (aiTest) { %>
          <div style="margin-top:14px">
            <div class="hint" style="margin-bottom:6px">Jawaban AI:</div>
            <div style="white-space:pre-wrap;background:#f8fafc;border:1px solid #e5e7eb;border-radius:10px;padding:12px;color:#111827;font-size:13px"><%= aiTest.answer %></div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card mb16">
      <div class="card-hd"><h6 style="margin:0"><i class="bi bi-list-check"></i> Kemampuan AI untuk Admin (<%= (tools || []).length %> perintah)</h6></div>
      <div class="card-bd">
        <div class="hint" style="margin-bottom:10px">Saat admin (nomor/ID terdaftar) mengobrol dengan bot, AI bisa menjalankan perintah ini dari bahasa natural.</div>
        <div class="tbl-wrap">
          <table class="dtbl">
            <thead>
              <tr><th style="width:220px">Perintah</th><th>Fungsi</th></tr>
            </thead>
            <tbody>
              <% (tools || []).forEach(function (tool) { %>
                <tr>
                  <td><code><%= tool.name %></code></td>
                  <td><%= tool.description %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-hd"><h6 style="margin:0"><i class="bi bi-info-circle"></i> Catatan</h6></div>
      <div class="card-bd">
        <ul style="margin:0;padding-left:18px;display:grid;gap:8px">
          <li>Token bot Telegram, Admin ID &amp; AI grup diatur di menu <a href="/admin/telegram">Telegram</a>.</li>
          <li>Koneksi WhatsApp diatur &amp; scan QR di menu <a href="/admin/whatsapp">WhatsApp</a>.</li>
          <li>Tanpa API key Gemini, AI tetap menjawab dari knowledge base lokal.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
<script>
// Multi-Provider AI UI Toggle
function toggleAiProviderFields() {
  const sel = document.getElementById('ai_provider_select');
  if (!sel) return;
  const val = sel.value || 'gemini';
  ['gemini', 'openai', 'deepseek', 'groq', 'openrouter', 'custom'].forEach(p => {
    const el = document.getElementById('ai_fields_' + p);
    if (el) el.style.display = (p === val) ? 'block' : 'none';
  });
}
toggleAiProviderFields();
</script>
</body>
</html>
